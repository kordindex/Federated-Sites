---
import Layout from '../layouts/layout.astro';
---

<Layout title="Coming Soon">

  <style>
    .coming-soon {
      padding: 80px 0 100px;
      min-height: 60vh;
      display: flex;
      align-items: center;
      text-align: center;
    }

    .coming-soon__inner {
      max-width: 800px;
      margin: 0 auto;
    }

    .coming-soon__eyebrow {
      font-family: var(--font-sans);
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--gold-accent);
      font-size: 0.75rem;
      font-weight: 800;
      display: block;
      margin-bottom: 2rem;
    }

    .coming-soon h1 {
      font-family: var(--font-serif);
      font-weight: 900;
      font-size: clamp(2.5rem, 7vw, 5rem);
      line-height: 1.1;
      margin-bottom: 1.5rem;
      color: var(--ink-institute);
    }

    .coming-soon h1 em {
      font-weight: 700;
      font-style: italic;
    }

    .coming-soon__lead {
      font-family: var(--font-serif);
      font-size: 1.35rem;
      line-height: 1.5;
      color: var(--silver-gray);
      max-width: 650px;
      margin: 0 auto 4rem;
    }

    /* ── Pillars ── */
    .pillars {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      margin-bottom: 5rem;
      text-align: left;
    }

    .pillar-card {
      padding: 2rem;
      border-left: 1px solid rgba(181, 147, 83, 0.3);
      background: var(--card-bg);
    }

    .pillar-card h3 {
      font-family: var(--font-sans);
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-accent);
      margin-bottom: 0.5rem;
    }

    .pillar-card p {
      font-size: 0.88rem;
      color: #555f5e;
      line-height: 1.6;
    }

    /* ── Inquiry form ── */
    .inquiry-box {
      background: var(--ink-institute);
      padding: 3.5rem;
      max-width: 650px;
      margin: 0 auto;
      color: #fff;
      text-align: left;
    }

    .inquiry-box h2 {
      font-family: var(--font-serif);
      font-size: 1.6rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      text-align: center;
      color: #fff;
    }

    .inquiry-box .form-intro {
      text-align: center;
      margin-bottom: 2.5rem;
      opacity: 0.6;
      font-size: 0.9rem;
    }

    .inquiry-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .inquiry-form .full-width {
      grid-column: span 2;
    }

    .inquiry-form input,
    .inquiry-form textarea {
      width: 100%;
      padding: 1rem;
      border: 1px solid rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.05);
      color: #fff;
      font-family: var(--font-sans);
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.3s;
    }

    .inquiry-form input::placeholder,
    .inquiry-form textarea::placeholder {
      color: rgba(255,255,255,0.4);
    }

    .inquiry-form input:focus,
    .inquiry-form textarea:focus {
      border-color: var(--gold-accent);
    }

    .inquiry-form textarea {
      height: 100px;
      resize: none;
    }

    .inquiry-form button {
      grid-column: span 2;
      padding: 1.2rem;
      background: var(--gold-accent);
      color: var(--ink-institute);
      border: none;
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      cursor: pointer;
      transition: background 0.3s, color 0.3s;
      margin-top: 0.5rem;
    }

    .inquiry-form button:hover {
      background: #fff;
      color: var(--ink-institute);
    }

    /* ── Responsive ── */
    @media (max-width: 600px) {
      .inquiry-form {
        grid-template-columns: 1fr;
      }

      .inquiry-form .full-width,
      .inquiry-form button {
        grid-column: span 1;
      }

      .inquiry-box {
        padding: 2rem;
      }

      .coming-soon {
        padding: 60px 0 80px;
      }
    }
  </style>

  <section class="coming-soon">
    <div class="container">
      <div class="coming-soon__inner">

        <span class="coming-soon__eyebrow">Coming Soon</span>

        <h1>
          Workplace Culture That<br>
          <em>Grows With You.</em>
        </h1>

        <p class="coming-soon__lead">
          Foundational frameworks for the future of organizational transformation.
        </p>

        <div class="pillars">
          <div class="pillar-card">
            <h3>Research Hub</h3>
            <p>Annual benchmarks and white papers on regenerative workplace culture.</p>
          </div>
          <div class="pillar-card">
            <h3>IP Library</h3>
            <p>Proprietary frameworks for systemic alignment and high-trust cultures.</p>
          </div>
          <div class="pillar-card">
            <h3>Certification</h3>
            <p>Professional accreditation in the UNLearning Methodology for practitioners.</p>
          </div>
        </div>

        <div class="inquiry-box">
          <h2>Get Early Access</h2>
          <p class="form-intro">Be the first to know when the Institute launches.</p>

          <form action="https://api.web3forms.com/submit" method="POST" class="inquiry-form">
            <input type="hidden" name="access_key" value="788508a9-5f62-4c66-a1e2-62e6106243f2">
            <input type="hidden" name="redirect" value="https://instituteforunlearning.com/thanks.html">
            <input type="hidden" name="subject" value="New Inquiry: The Institute for UNLearning">
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

            <input type="text" name="name" placeholder="Full Name" required>
            <input type="email" name="email" placeholder="Professional Email" required>

            <div class="full-width">
              <textarea name="message" placeholder="How can the Institute support your organization?"></textarea>
            </div>

            <button type="submit">Send Inquiry</button>
          </form>
        </div>

      </div>
    </div>
  </section>

</Layout>