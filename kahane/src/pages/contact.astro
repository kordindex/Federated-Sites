---
import Layout from '../layouts/layout.astro';
---

<Layout
  title="Contact"
  description="Book a consultation with Christine Kahane, NBC-HWC. Executive, Health & Wellness, and Divorce Coaching."
>

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Get in Touch</span>
      <h1 class="page-title">Start a <em>Conversation.</em></h1>
      <p class="page-subhead">The first step is simply reaching out. Christine will respond personally within one business day.</p>
    </div>
  </section>

  <!-- ============================================================
       CONTACT GRID
       ============================================================ -->
  <section class="section-contact">
    <div class="container">
      <div class="contact-grid">

        <!-- Left: form -->
        <div class="contact-form-wrap">
          <span class="eyebrow">Send a Message</span>
          <div class="section-rule"></div>

          <form class="contact-form" name="contact" method="POST">
            <div class="form-row">
              <div class="form-field">
                <label for="first-name">First Name</label>
                <input type="text" id="first-name" name="first-name" placeholder="First name" required />
              </div>
              <div class="form-field">
                <label for="last-name">Last Name</label>
                <input type="text" id="last-name" name="last-name" placeholder="Last name" required />
              </div>
            </div>

            <div class="form-field">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="your@email.com" required />
            </div>

            <div class="form-field">
              <label for="interest">Area of Interest</label>
              <select id="interest" name="interest">
                <option value="" disabled selected>Select one</option>
                <option value="executive">Executive Coaching</option>
                <option value="health-wellness">Health & Wellness Coaching</option>
                <option value="divorce">Divorce Coaching</option>
                <option value="communications">Communications Program</option>
                <option value="diagnostic">Essential Coherence Diagnostic</option>
                <option value="other">Other / Not Sure Yet</option>
              </select>
            </div>

            <div class="form-field">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" placeholder="Tell Christine a little about what's on your mind..."></textarea>
            </div>

            <button type="submit" class="btn-submit">Send Message</button>
          </form>
        </div>

        <!-- Right: info -->
        <div class="contact-info">

          <div class="info-block">
            <span class="info-label">Email</span>
            <a href="mailto:christine@kahanecoaching.com" class="info-value">christine@kahanecoaching.com</a>
          </div>

          <div class="info-block">
            <span class="info-label">Phone</span>
            <a href="tel:3035895456" class="info-value">303.589.5456</a>
          </div>

          <div class="info-block">
            <span class="info-label">Book a Free Consultation</span>
            <p class="info-body">Prefer to schedule directly? Use Christine's calendar to book a complimentary 30-minute consultation.</p>
            <a href="https://calendly.com/coherencecompany" target="_blank" rel="noopener" class="btn-ghost">Book via Calendly →</a>
          </div>

          <div class="info-divider"></div>

          <div class="info-block">
            <span class="info-label">Response Time</span>
            <p class="info-body">Christine responds personally to every inquiry, typically within one business day.</p>
          </div>

          <div class="info-block">
            <span class="info-label">Confidentiality</span>
            <p class="info-body">All conversations are completely confidential under NBHWC ethical standards. What you share stays in the room.</p>
          </div>

        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  :root {
    --gold:       #C4922A;
    --silver:     #8C9490;
    --limestone:  #EEF2F1;
    --warm-white: #F4F7F6;
    --green:      #18332F;
    --green-mid:  #1f4038;
    --body-color: #2C3A4A;
    --muted:      #5C7068;
    --divider:    rgba(24, 51, 47, 0.1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  /* ── Shared ── */
  .eyebrow {
    display: block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  .section-rule {
    width: 40px;
    height: 2px;
    background: var(--gold);
    margin-bottom: 2rem;
  }

  /* ── Hero ── */
  .page-hero {
    background: var(--limestone);
    padding: 80px 0 70px;
    border-bottom: 1px solid var(--divider);
  }

  .page-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 900;
    color: var(--green);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .page-title em {
    font-style: italic;
    font-weight: 700;
  }

  .page-subhead {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-style: italic;
    color: var(--green-mid);
    opacity: 0.85;
    max-width: 560px;
    margin-bottom: 0;
  }

  /* ── Contact Section ── */
  .section-contact {
    background: var(--warm-white);
    padding: 100px 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 6rem;
    align-items: start;
  }

  /* ── Form ── */
  .contact-form-wrap {
    /* left column */
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-field label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.95rem;
    color: var(--body-color);
    background: #fff;
    border: 0.5px solid var(--divider);
    border-bottom: 1.5px solid rgba(24, 51, 47, 0.25);
    padding: 0.75rem 1rem;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-bottom-color: var(--green);
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--silver);
    font-style: italic;
  }

  .form-field textarea {
    resize: vertical;
    min-height: 130px;
    line-height: 1.7;
  }

  .btn-submit {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: var(--green);
    border: none;
    padding: 0.9rem 1.75rem;
    cursor: pointer;
    transition: background 0.2s;
    align-self: flex-start;
  }

  .btn-submit:hover {
    background: var(--green-mid);
  }

  /* ── Info column ── */
  .contact-info {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .info-block {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--divider);
  }

  .info-block:first-child {
    border-top: 1px solid var(--divider);
  }

  .info-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 0.4rem;
  }

  .info-value {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1rem;
    color: var(--green);
    text-decoration: none;
    display: block;
    transition: color 0.2s;
  }

  .info-value:hover {
    color: var(--gold);
  }

  .info-body {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 0.75rem;
  }

  .btn-ghost {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
    text-decoration: none;
    border-bottom: 1px solid var(--green);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
    display: inline-block;
  }

  .btn-ghost:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .info-divider {
    height: 1px;
    background: var(--divider);
    margin: 0.5rem 0;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .contact-info {
      position: static;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .section-contact {
      padding: 60px 0;
    }

    .container {
      padding: 0 1.5rem;
    }
  }
</style>