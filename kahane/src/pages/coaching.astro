---
import Layout from '../layouts/layout.astro';
---

<Layout
  title="Coaching Programs"
  description="Christine Kahane offers Personal Transformation, Professional Growth, Executive Coherence, and Leadership Architecture coaching programs for executives and senior leaders."
>

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Coaching Practice</span>
      <h1 class="page-title">Find the Program<br><em>That Fits.</em></h1>
      <p class="page-subhead">My coaching programs are designed so we can find the one that fits your needs. All sessions are virtual.</p>
    </div>
  </section>

  <!-- ============================================================
       PROGRAMS
       ============================================================ -->
  <section class="section-programs">
    <div class="container">

      <!-- Personal Transformation -->
      <div class="program-row fade-up" id="personal-transformation">
        <div class="program-left">
          <span class="program-num">01</span>
          <h2 class="program-title">Personal Transformation</h2>
          <p class="program-tagline">Identity reconstruction and personal authority rebuilding.</p>
          <div class="program-meta">
            <div class="meta-item">
              <span class="meta-label">Duration</span>
              <span class="meta-value">12 sessions · 3 months</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Investment</span>
              <span class="meta-value">$4,200</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Pay in Full</span>
              <span class="meta-value">$4,000</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Payment Plan</span>
              <span class="meta-value">3 × $1,400 / month</span>
            </div>
          </div>
          <a href="/contact" class="btn-primary">Book a Consultation</a>
        </div>
        <div class="program-right">
          <p>Designed for identity reconstruction, behavioral recalibration, and personal authority rebuilding.</p>
          <div class="program-includes">
            <span class="includes-label">What's included</span>
            <div class="include-item">12 structured 60-minute coaching sessions over 3 months</div>
            <div class="include-item">A clearly defined transformation focus identified in the first session</div>
            <div class="include-item">Pattern recognition and root-cause behavioral mapping</div>
            <div class="include-item">Real-time interruption of limiting cognitive and emotional loops</div>
            <div class="include-item">Nervous system stabilization techniques for high-stakes moments</div>
            <div class="include-item">Boundary design and relational recalibration tools</div>
            <div class="include-item">Identity reconstruction work — who you are becoming vs. who you were surviving as</div>
            <div class="include-item">Accountability structures between sessions</div>
            <div class="include-item">Measurable behavioral experiments and integration practices</div>
            <div class="include-item">A formal recalibration session at the conclusion of the cycle</div>
          </div>
        </div>
      </div>

      <!-- Professional Growth -->
      <div class="program-row fade-up" id="professional-growth">
        <div class="program-left">
          <span class="program-num">02</span>
          <h2 class="program-title">Professional Growth</h2>
          <p class="program-tagline">Performance expansion and strategic behavioral precision.</p>
          <div class="program-meta">
            <div class="meta-item">
              <span class="meta-label">Duration</span>
              <span class="meta-value">12 sessions · 3 months</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Investment</span>
              <span class="meta-value">$4,800</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Pay in Full</span>
              <span class="meta-value">$4,600</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Payment Plan</span>
              <span class="meta-value">3 × $1,600 / month</span>
            </div>
          </div>
          <a href="/contact" class="btn-primary">Book a Consultation</a>
        </div>
        <div class="program-right">
          <p>Designed for performance expansion, leadership positioning, and strategic behavioral precision.</p>
          <div class="program-includes">
            <span class="includes-label">What's included</span>
            <div class="include-item">12 structured 60–75 minute coaching sessions over 3 months</div>
            <div class="include-item">Clear performance objectives defined at engagement start</div>
            <div class="include-item">Leadership pattern diagnostics and power-mapping</div>
            <div class="include-item">Strategic communication calibration</div>
            <div class="include-item">Authority posture refinement</div>
            <div class="include-item">Conflict navigation and influence expansion frameworks</div>
            <div class="include-item">Behavioral alignment between internal identity and external role</div>
            <div class="include-item">Decision-making clarity under complexity</div>
            <div class="include-item">Accountability metrics tied to real-world professional outcomes</div>
            <div class="include-item">A formal 90-minute strategic recalibration session at cycle close</div>
          </div>
        </div>
      </div>

      <!-- Executive Coherence -->
      <div class="program-row program-row--featured fade-up" id="executive-coherence">
        <div class="program-left">
          <span class="program-num">03</span>
          <h2 class="program-title">Executive Coherence</h2>
          <p class="program-tagline">Senior leaders navigating complexity, growth pressure, and organizational responsibility.</p>
          <div class="program-meta">
            <div class="meta-item">
              <span class="meta-label">Duration</span>
              <span class="meta-value">12 sessions · 3 months</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Investment</span>
              <span class="meta-value">$9,000</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Pay in Full</span>
              <span class="meta-value">$8,750</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Payment Plan</span>
              <span class="meta-value">3 × $3,000 / month</span>
            </div>
          </div>
          <a href="/contact" class="btn-primary">Book a Consultation</a>
        </div>
        <div class="program-right">
          <p>Designed for senior leaders navigating complexity, growth pressure, and organizational responsibility.</p>
          <div class="program-includes">
            <span class="includes-label">What's included</span>
            <div class="include-item">12 structured 75–90 minute executive sessions</div>
            <div class="include-item">Clear leadership objectives defined at engagement outset</div>
            <div class="include-item">Leadership style and behavioral impact assessment (as applicable)</div>
            <div class="include-item">Strategic clarity under high-stakes decision pressure</div>
            <div class="include-item">Executive presence and authority calibration</div>
            <div class="include-item">Conflict navigation at senior levels</div>
            <div class="include-item">Board and stakeholder communication refinement</div>
            <div class="include-item">Pattern interruption at the power level: ego traps, reactive cycles, escalation dynamics</div>
            <div class="include-item">Culture impact awareness — how leadership stance shapes system performance</div>
            <div class="include-item">Organizational lensing: diagnosing structural vs. personal issues</div>
            <div class="include-item">Real-time advisory on active leadership dilemmas</div>
            <div class="include-item">Quarterly leadership recalibration review</div>
            <div class="include-item">Defined outcomes and executive growth markers</div>
            <div class="include-item">Limited email support between sessions (by agreement)</div>
            <div class="include-item">One stakeholder alignment conversation (optional)</div>
          </div>
        </div>
      </div>

      <!-- Leadership Architecture -->
      <div class="program-row fade-up" id="leadership-architecture">
        <div class="program-left">
          <span class="program-num">04</span>
          <h2 class="program-title">Leadership Architecture</h2>
          <p class="program-tagline">A year-long executive container for durable leadership coherence.</p>
          <div class="program-meta">
            <div class="meta-item">
              <span class="meta-label">Duration</span>
              <span class="meta-value">12 months</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Investment</span>
              <span class="meta-value">$36,000</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Pay in Full</span>
              <span class="meta-value">$34,000</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Payment Plan</span>
              <span class="meta-value">Quarterly · $9,000</span>
            </div>
          </div>
          <a href="/contact" class="btn-primary">Book a Consultation</a>
        </div>
        <div class="program-right">
          <p>A year-long executive container designed to build durable leadership coherence under complexity, pressure, and scale.</p>

          <div class="program-includes">
            <span class="includes-label">What This Engagement Is</span>
            <div class="include-item">A longitudinal leadership redesign</div>
            <div class="include-item">A contained advisory partnership</div>
            <div class="include-item">A coherence-building system at executive altitude</div>
          </div>

          <div class="program-includes">
            <span class="includes-label">Foundational Architecture</span>
            <div class="include-item">Comprehensive leadership diagnostic and behavioral pattern mapping</div>
            <div class="include-item">Defined leadership mandate and measurable transformation objectives</div>
            <div class="include-item">Executive identity recalibration: power, authority, and presence</div>
            <div class="include-item">Structural alignment between personal leadership stance and organizational demands</div>
          </div>

          <div class="program-includes">
            <span class="includes-label">Ongoing Strategic Containment</span>
            <div class="include-item">2 executive sessions per month (75–90 minutes)</div>
            <div class="include-item">Real-time advisory during high-stakes inflection points</div>
            <div class="include-item">Power-dynamics and stakeholder mapping</div>
            <div class="include-item">Escalation cycle interruption and decision recalibration</div>
            <div class="include-item">Culture-shaping interventions tied to organizational outcomes</div>
          </div>

          <div class="program-includes">
            <span class="includes-label">Coherence Under Complexity</span>
            <div class="include-item">Nervous system regulation at scale: pressure, visibility, consequence</div>
            <div class="include-item">Executive communication precision under volatility</div>
            <div class="include-item">Conflict and board-level navigation strategy</div>
            <div class="include-item">Integration of strategy, culture, and performance alignment</div>
          </div>

          <div class="program-includes">
            <span class="includes-label">Organizational Impact Layer</span>
            <div class="include-item">Diagnosing structural vs. behavioral breakdowns</div>
            <div class="include-item">Alignment mapping across leadership team (as appropriate)</div>
            <div class="include-item">Strategic clarity in growth, crisis, or transition phases</div>
            <div class="include-item">Performance durability architecture — not short-term wins</div>
          </div>

          <div class="program-includes">
            <span class="includes-label">Quarterly Recalibration Intensives</span>
            <div class="include-item">90-minute deep recalibration sessions every quarter</div>
            <div class="include-item">Review of metrics, relational climate, and leadership posture</div>
            <div class="include-item">Structural adjustment to meet evolving complexity</div>
          </div>

          <div class="program-includes">
            <span class="includes-label">Year-End Strategic Review</span>
            <div class="include-item">Formal transformation review and next-phase mapping</div>
            <div class="include-item">Clear articulation of leadership evolution across 12 months</div>
            <div class="include-item">Decision point: continue architecture, pivot scope, or complete</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================
       CTA
       ============================================================ -->
  <section class="section-cta">
    <div class="container">
      <div class="cta-inner">
        <h2 class="cta-title">Not sure which program is right for you?</h2>
        <p class="cta-body">Book a complimentary consultation. Christine will help you identify the program that best fits your needs, goals, and life circumstances.</p>
        <a href="/contact" class="btn-primary-light">Book a Free Consultation</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  :root {
    --gold:       #C4922A;
    --silver:     #8C9490;
    --limestone:  #EEF2F1;
    --warm-white: #F4F7F6;
    --warm-white-2: #EFF3F2;
    --green:      #18332F;
    --green-mid:  #1f4038;
    --body-color: #2C3A4A;
    --muted:      #5C7068;
    --divider:    rgba(24, 51, 47, 0.1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  .eyebrow {
    display: block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  p {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.97rem;
    color: var(--muted);
    line-height: 1.9;
    margin-bottom: 1.25rem;
  }

  .btn-primary {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: var(--green);
    padding: 0.9rem 1.75rem;
    text-decoration: none;
    transition: background 0.2s;
    display: inline-block;
    margin-top: 1.5rem;
  }
  .btn-primary:hover { background: var(--green-mid); color: #fff; }

  .btn-primary-light {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
    background: #fff;
    padding: 0.9rem 1.75rem;
    text-decoration: none;
    transition: background 0.2s;
    display: inline-block;
  }
  .btn-primary-light:hover { background: var(--limestone); }

  .page-hero {
    background: var(--limestone);
    padding: 80px 0 70px;
    border-bottom: 1px solid var(--divider);
  }

  .page-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 900;
    color: var(--green);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .page-title em {
    font-style: italic;
    font-weight: 700;
  }

  .page-subhead {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-style: italic;
    color: var(--green-mid);
    opacity: 0.85;
    max-width: 560px;
    margin-bottom: 0;
  }

  .section-programs {
    background: var(--warm-white);
    padding: 80px 0 100px;
  }

  .program-row {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 5rem;
    align-items: start;
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--divider);
  }

  .program-row:first-child {
    border-top: 1px solid var(--divider);
  }

  .program-row--featured {
    background: #fff;
    margin: 0 -2.5rem;
    padding: 3.5rem 2.5rem;
    border-left: 3px solid var(--gold);
  }

  .program-left {
    position: sticky;
    top: 80px;
  }

  .program-num {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 0.75rem;
  }

  .program-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    font-weight: 700;
    color: var(--green);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .program-tagline {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    color: var(--silver);
    font-style: italic;
    margin-bottom: 1.75rem;
  }

  .program-meta {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 0.5px solid var(--divider);
    margin-bottom: 0;
  }

  .meta-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0.9rem;
    border-bottom: 0.5px solid var(--divider);
    background: #fff;
  }

  .meta-item:last-child { border-bottom: none; }

  .meta-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--silver);
  }

  .meta-value {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--green);
  }

  .program-includes {
    margin-top: 1.5rem;
    border-top: 1px solid var(--divider);
    padding-top: 1.25rem;
  }

  .includes-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 0.75rem;
  }

  .include-item {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.88rem;
    color: var(--body-color);
    line-height: 1.7;
    padding: 0.4rem 0;
    border-bottom: 0.5px solid var(--divider);
    padding-left: 1rem;
    position: relative;
  }

  .include-item::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--gold);
    font-size: 0.7rem;
  }

  .include-item:last-child { border-bottom: none; }

  .section-cta {
    background: var(--green);
    padding: 80px 0;
  }

  .cta-inner { max-width: 600px; }

  .cta-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cta-body {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.97rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.9;
    margin-bottom: 2rem;
  }

  @media (max-width: 900px) {
    .program-row {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .program-left { position: static; }

    .program-row--featured {
      margin: 0 -1.5rem;
      padding: 3rem 1.5rem;
    }

    .section-programs { padding: 60px 0; }
    .container { padding: 0 1.5rem; }
  }
</style>