---
import Layout from '../layouts/layout.astro';
---

<Layout
  title="About Christine"
  description="Christine Kahane is a Nationally Board Certified Health and Wellness Coach specializing in Executive and Divorce Coaching with 25+ years of experience."
>

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-left">
          <span class="eyebrow">About Christine</span>
          <h1 class="page-title">Live Your Life<br><em>On Purpose.</em></h1>
          <p class="page-subhead">Nationally Board Certified Health and Wellness Coach, specializing in Executive and Divorce Coaching.</p>
          <div class="hero-creds">
            <span class="cred-tag">NBC-HWC</span>
            <span class="cred-tag">MCWC</span>
            <span class="cred-tag">TIPF</span>
          </div>
        </div>
        <div class="hero-right">
          <div class="hero-photo-wrap">
            <img
              src="/christine-hero.jpg"
              alt="Christine Kahane, Executive and Wellness Coach"
              class="hero-photo"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       WELCOME / INTRO
       ============================================================ -->
  <section class="section-welcome">
    <div class="container">
      <div class="welcome-grid">

        <div class="welcome-left">
          <span class="eyebrow">Welcome</span>
          <div class="section-rule"></div>
          <h2 class="section-title">Bringing your innate genius online.</h2>
          <a href="/contact" class="btn-primary" style="margin-top: 2rem; display: inline-block;">Book a Consultation</a>
        </div>

        <div class="welcome-right">
          <p>I am a Nationally Board Certified Health and Wellness Coach, specializing in Executive and Divorce Coaching. I offer private-session programs to help you navigate change, work through transitions, and liberate you from what no longer serves your well-being and success.</p>

          <h3 class="subsection-title">The Heart of Coaching</h3>
          <p>Our work together focuses on bringing your innate genius online. I've developed techniques that integrate your untapped emotional intelligence. I use communication tools to transform what isn't serving your well-being and success.</p>
          <p>If you want to find your life's road map through Health & Wellness Coaching, we'll harness your courage to transform the way you do life, so you are driving your own lasting life changes.</p>
          <p>If you're facing divorce, Health and Wellness coaching not only will help you navigate difficult choices you face, but also assist you in gaining self-acceptance, trust in your decisions, and healthy release from a way of life that no longer serves, into a life filled with what you most long for.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       EXECUTIVE CLIENT WORK
       ============================================================ -->
  <section class="section-clients">
    <div class="container">
      <div class="clients-grid">

        <div class="clients-left">
          <span class="eyebrow">Executive Client Work</span>
          <div class="section-rule"></div>
          <h2 class="section-title">25+ years across private, public, and government sectors.</h2>
          <a href="/contact" class="btn-primary" style="margin-top: 2rem; display: inline-block;">Book a Consultation</a>
        </div>

        <div class="clients-right">
          <p>My Executive Coaching experience is rooted in leadership development and culture shift coaching — and includes internationally recognized brands, among them:</p>

          <div class="client-list">
            <div class="client-category">
              <span class="client-label">Private Sector</span>
              <div class="client-names">
                R.H. Macy & Co. · Shearson Lehman Brothers · American Express · Barneys New York · Microsoft · Federated Department Stores · The Landmark Group · Mercy Health Systems
              </div>
            </div>
            <div class="client-category">
              <span class="client-label">Public Sector</span>
              <div class="client-names">
                EPS · US NAVAIR · USAging · Numerous city and county police departments across the country
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       CREDENTIALS
       ============================================================ -->
  <section class="section-credentials">
    <div class="container">
      <div class="credentials-header">
        <span class="eyebrow">Credentials</span>
        <div class="section-rule"></div>
        <h2 class="section-title">Certified. Trained. Experienced.</h2>
      </div>

      <div class="credentials-grid">

        <div class="credential-card fade-up">
          <span class="credential-num">01</span>
          <h3 class="credential-title">Nationally Board Certified Health and Wellness Coach</h3>
          <p class="credential-body">NBME, NBC-HWC</p>
        </div>

        <div class="credential-card fade-up">
          <span class="credential-num">02</span>
          <h3 class="credential-title">Certified Facilitator, Counselor</h3>
          <p class="credential-body">TTIsi Communications Sciences</p>
        </div>

        <div class="credential-card fade-up">
          <span class="credential-num">03</span>
          <h3 class="credential-title">Certified Conflict Resolution Mediator</h3>
          <p class="credential-body">Colorado Bar Association</p>
        </div>

        <div class="credential-card fade-up">
          <span class="credential-num">04</span>
          <h3 class="credential-title">Executive Coach, Leadership Facilitator</h3>
          <p class="credential-body">Institute for UNLearning</p>
        </div>

        <div class="credential-card fade-up">
          <span class="credential-num">05</span>
          <h3 class="credential-title">Certified Trauma-Informed Process Facilitator</h3>
          <p class="credential-body">Santa Fe Institute for Shame-Based Studies</p>
        </div>

        <div class="credential-card fade-up">
          <span class="credential-num">06</span>
          <h3 class="credential-title">Mental Health Neutral</h3>
          <p class="credential-body">Colorado Collaborative Divorce Professionals</p>
        </div>

        <div class="credential-card fade-up">
          <span class="credential-num">07</span>
          <h3 class="credential-title">Master Certified Health and Wellness Coach</h3>
          <p class="credential-body">Catalyst Coaching Institute</p>
        </div>

        <div class="credential-card fade-up">
          <span class="credential-num">08</span>
          <h3 class="credential-title">Coach, Facilitator</h3>
          <p class="credential-body">Awake At Work · Return To Center</p>
        </div>

        <div class="credential-card fade-up">
          <span class="credential-num">09</span>
          <h3 class="credential-title">Mentor Coach</h3>
          <p class="credential-body">Center for Sacred Leadership</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       CTA
       ============================================================ -->
  <section class="section-cta">
    <div class="container">
      <div class="cta-inner">
        <h2 class="cta-title">Ready to begin?</h2>
        <p class="cta-body">Book a free consultation to explore how coaching can help you navigate change, transition, and growth.</p>
        <a href="/contact" class="btn-primary-light">Book a Consultation</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  :root {
    --gold:       #C4922A;
    --silver:     #8C9490;
    --limestone:  #EEF2F1;
    --warm-white: #F4F7F6;
    --warm-white-2: #EFF3F2;
    --green:      #18332F;
    --green-mid:  #1f4038;
    --body-color: #2C3A4A;
    --muted:      #5C7068;
    --divider:    rgba(24, 51, 47, 0.1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  @media (max-width: 900px) {
    .container { padding: 0 1.5rem; }
  }

  /* ── Shared ── */
  .eyebrow {
    display: block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  .section-rule {
    width: 40px;
    height: 2px;
    background: var(--gold);
    margin-bottom: 2rem;
  }

  .section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 700;
    color: var(--green);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .subsection-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--green);
    margin: 2rem 0 0.75rem;
    line-height: 1.3;
  }

  p {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.97rem;
    color: var(--muted);
    line-height: 1.9;
    margin-bottom: 1.25rem;
  }

  .btn-primary {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: var(--green);
    padding: 0.9rem 1.75rem;
    text-decoration: none;
    transition: background 0.2s;
    display: inline-block;
  }
  .btn-primary:hover { background: var(--green-mid); color: #fff; }

  .btn-primary-light {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
    background: #fff;
    padding: 0.9rem 1.75rem;
    text-decoration: none;
    transition: background 0.2s;
    display: inline-block;
  }
  .btn-primary-light:hover { background: var(--limestone); }

  /* ── Page Hero ── */
  .page-hero {
    background: var(--limestone);
    padding: 80px 0 0;
    border-bottom: 1px solid var(--divider);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: end;
  }

  .hero-left {
    padding-bottom: 70px;
  }

  .page-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 900;
    color: var(--green);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .page-title em {
    font-style: italic;
    font-weight: 700;
  }

  .page-subhead {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-style: italic;
    color: var(--green-mid);
    opacity: 0.85;
    max-width: 600px;
    margin-bottom: 1.5rem;
  }

  .hero-creds {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cred-tag {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid rgba(196, 146, 42, 0.3);
    padding: 0.3rem 0.65rem;
  }

  .hero-right {
    align-self: end;
  }

  .hero-photo-wrap {
    border-top: 4px solid var(--gold);
    padding-bottom: 2.5rem;
  }

  .hero-photo {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: grayscale(8%);
  }

  /* ── Welcome ── */
  .section-welcome {
    background: var(--warm-white);
    padding: 100px 0;
    border-bottom: 1px solid var(--divider);
  }

  .welcome-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 6rem;
    align-items: start;
  }

  .welcome-left {
    position: sticky;
    top: 80px;
  }

  /* ── Executive Clients ── */
  .section-clients {
    background: var(--warm-white-2);
    padding: 100px 0;
    border-bottom: 1px solid var(--divider);
  }

  .clients-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 6rem;
    align-items: start;
  }

  .clients-left {
    position: sticky;
    top: 80px;
  }

  .client-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 1.5rem;
    border: 0.5px solid var(--divider);
  }

  .client-category {
    padding: 1.5rem 2rem;
    border-bottom: 0.5px solid var(--divider);
    background: #fff;
  }

  .client-category:last-child {
    border-bottom: none;
  }

  .client-label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 0.6rem;
  }

  .client-names {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.9rem;
    color: var(--body-color);
    line-height: 1.8;
  }

  /* ── Credentials ── */
  .section-credentials {
    background: var(--warm-white);
    padding: 100px 0;
    border-bottom: 1px solid var(--divider);
  }

  .credentials-header {
    margin-bottom: 4rem;
  }

  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 0.5px solid var(--divider);
  }

  .credential-card {
    padding: 2.25rem;
    border-right: 0.5px solid var(--divider);
    border-bottom: 0.5px solid var(--divider);
    background: #fff;
    transition: background 0.2s;
  }

  .credential-card:hover { background: var(--limestone); }

  /* Remove right border on every 3rd card */
  .credential-card:nth-child(3n) { border-right: none; }

  /* Remove bottom border on last row */
  .credential-card:nth-last-child(-n+3) { border-bottom: none; }

  .credential-num {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
    display: block;
  }

  .credential-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--green);
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .credential-body {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* ── CTA ── */
  .section-cta {
    background: var(--green);
    padding: 80px 0;
  }

  .cta-inner {
    max-width: 600px;
  }

  .cta-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cta-body {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.97rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.9;
    margin-bottom: 2rem;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-left {
      padding-bottom: 0;
    }

    .hero-photo {
      height: 340px;
    }

    .welcome-grid,
    .clients-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .welcome-left,
    .clients-left {
      position: static;
    }

    .credentials-grid {
      grid-template-columns: 1fr;
    }

    .credential-card {
      border-right: none;
    }

    .credential-card:nth-last-child(-n+3) {
      border-bottom: 0.5px solid var(--divider);
    }

    .credential-card:last-child {
      border-bottom: none;
    }

    .section-welcome,
    .section-clients,
    .section-credentials {
      padding: 60px 0;
    }
  }
</style>
