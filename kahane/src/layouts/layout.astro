---
import GlobalFooter from '@shared/components/GlobalFooter.astro';
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Christine Kahane, NBC-HWC — Executive, Health & Wellness, and Divorce Coaching grounded in 25 years of communication science.",
  ogImage = "/og-default.jpg",
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : null;

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script src="https://cdn.usefathom.com/script.js" data-site="FXKIHAQN" defer></script>

    <title>{title} | Kahane Coaching</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --green-900: #18332F;
        --green-800: #1f4038;
        --green-700: #33503f;
        --green-600: #3d6149;
        --green-500: #4a7358;
        --green-400: #6a9a7a;
        --green-200: #c5d9cc;
        --green-100: #e8f0eb;
        --green-50:  #f4f7f5;

        --gold:       #C4922A;
        --gold-light: #D4A84B;
        --silver:     #8C9490;

        --limestone:    #EEF2F1;
        --warm-white:   #F4F7F6;
        --warm-white-2: #EFF3F2;

        --body-color:  #2C3A4A;
        --muted:       #5C7068;
        --divider:     rgba(24, 51, 47, 0.1);

        --bg-page:         var(--warm-white);
        --bg-card:         #ffffff;
        --text-headline:   var(--green-900);
        --text-body:       var(--body-color);
        --text-muted:      var(--muted);
        --text-eyebrow:    var(--gold);
        --text-on-dark:    #e8f0eb;
        --text-on-dark-muted: rgba(232, 240, 235, 0.55);

        --font-serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
        --font-sans:  'DM Sans', system-ui, sans-serif;

        --text-xs:   0.75rem;
        --text-sm:   0.875rem;
        --text-base: 1rem;
        --text-lg:   1.125rem;
        --text-xl:   1.25rem;
        --text-2xl:  1.5rem;
        --text-3xl:  1.875rem;
        --text-4xl:  2.25rem;
        --text-5xl:  3rem;
        --text-6xl:  3.75rem;

        --space-1:  0.25rem;
        --space-2:  0.5rem;
        --space-3:  0.75rem;
        --space-4:  1rem;
        --space-6:  1.5rem;
        --space-8:  2rem;
        --space-10: 2.5rem;
        --space-12: 3rem;
        --space-16: 4rem;
        --space-20: 5rem;
        --space-24: 6rem;

        --max-width:       1200px;
        --max-width-prose: 680px;

        --radius-sm: 4px;
        --radius-md: 8px;
        --border-subtle: 1px solid var(--divider);

        --transition-fast: 150ms ease;
        --transition-base: 250ms ease;

        --shadow-sm: 0 1px 3px rgba(30, 48, 40, 0.08);
        --shadow-md: 0 4px 16px rgba(30, 48, 40, 0.10);
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 16px;
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      body {
        font-family: var(--font-serif);
        font-size: var(--text-base);
        line-height: 1.65;
        color: var(--text-body);
        background-color: var(--bg-page);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main { flex: 1; }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      a {
        color: var(--text-headline);
        text-decoration: none;
        transition: color var(--transition-fast);
      }

      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 2.5rem;
      }

      @media (max-width: 900px) {
        .container { padding: 0 1.5rem; }
      }

      .ecosystem-bar {
        background: #fff;
        border-bottom: 1px solid var(--divider);
        overflow-x: auto;
      }

      .ecosystem-bar__inner {
        display: flex;
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .ecosystem-bar__item {
        flex: 1;
        padding: 0.5rem 1.5rem;
        text-decoration: none;
        border-right: 1px solid var(--divider);
        transition: background 0.2s;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 160px;
      }

      .ecosystem-bar__item:last-child { border-right: none; }
      .ecosystem-bar__item:hover { background: var(--limestone); }
      .ecosystem-bar__item--active { background: var(--limestone); }

      .ecosystem-bar__label {
        display: block;
        font-family: var(--font-sans);
        font-size: 0.52rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--silver);
        margin-bottom: 0.15rem;
        line-height: 1.2;
      }

      .ecosystem-bar__name {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--body-color);
        line-height: 1.3;
      }

      .ecosystem-bar__item--active .ecosystem-bar__name {
        color: var(--green-900);
      }

      .site-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.97);
        border-bottom: 1px solid var(--divider);
        height: 64px;
        display: flex;
        align-items: center;
      }

      .site-nav__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        gap: var(--space-8);
      }

      .site-nav__brand {
        font-family: var(--font-serif);
        font-weight: 900;
        font-size: 1.2rem;
        color: var(--green-900);
        text-decoration: none;
        flex-shrink: 0;
        white-space: nowrap;
      }

      .site-nav__brand span { color: var(--gold); }

      .site-nav__links {
        display: flex;
        gap: 1.25rem;
        list-style: none;
      }

      .site-nav__links a {
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        text-decoration: none;
        transition: color 0.2s;
        white-space: nowrap;
      }

      .site-nav__links a:hover,
      .site-nav__links a[aria-current="page"] {
        color: var(--green-900);
      }

      .site-nav__cta {
        font-family: var(--font-sans);
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #fff;
        background: var(--green-900);
        padding: 0.65rem 1.25rem;
        text-decoration: none;
        transition: background 0.2s;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .site-nav__cta:hover {
        background: var(--green-800);
        color: #fff;
      }

      .site-nav__toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 32px;
        height: 32px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        flex-shrink: 0;
      }

      .site-nav__toggle span {
        display: block;
        width: 22px;
        height: 1.5px;
        background: var(--green-900);
        transition: all 0.25s ease;
        transform-origin: center;
      }

      .site-nav__toggle.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
      .site-nav__toggle.open span:nth-child(2) { opacity: 0; }
      .site-nav__toggle.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

      .mobile-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(24, 51, 47, 0.6);
        z-index: 99;
        opacity: 0;
        transition: opacity 0.25s ease;
      }

      .mobile-overlay.open {
        display: block;
        opacity: 1;
      }

      .mobile-menu {
        position: absolute;
        top: 0;
        right: 0;
        width: 280px;
        height: 100%;
        background: #fff;
        padding: 5rem 2rem 2rem;
        display: flex;
        flex-direction: column;
        gap: 0;
        border-left: 2px solid var(--green-900);
        transform: translateX(100%);
        transition: transform 0.3s ease;
      }

      .mobile-overlay.open .mobile-menu { transform: translateX(0); }

      .mobile-menu a {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--green-900);
        text-decoration: none;
        padding: 1rem 0;
        border-bottom: 0.5px solid var(--divider);
        transition: color 0.2s;
      }

      .mobile-menu a:hover { color: var(--gold); }

      .mobile-menu .mobile-cta {
        margin-top: 2rem;
        background: var(--green-900);
        color: #fff;
        text-align: center;
        padding: 0.9rem;
        border-bottom: none;
      }

      .mobile-menu .mobile-cta:hover {
        background: var(--green-800);
        color: #fff;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      .fade-up {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }

      .fade-up.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      @media (max-width: 900px) {
        .ecosystem-bar span { display: none; }
        .site-nav__links { display: none; }
        .site-nav__cta { display: none; }
        .site-nav__toggle { display: flex; }
      }
    </style>
  </head>

  <body>

    <nav class="ecosystem-bar" aria-label="Ecosystem navigation">
      <div class="ecosystem-bar__inner">
        <a href="https://institute-unlearning.vercel.app/" class="ecosystem-bar__item">
          <span class="ecosystem-bar__label">The Master Brand</span>
          <span class="ecosystem-bar__name">The Institute</span>
        </a>
        <a href="https://coherence-company.vercel.app/" class="ecosystem-bar__item">
          <span class="ecosystem-bar__label">B2B / Organizations</span>
          <span class="ecosystem-bar__name">The Coherence Co.</span>
        </a>
        <a href="/" class="ecosystem-bar__item ecosystem-bar__item--active">
          <span class="ecosystem-bar__label">B2C / Individuals</span>
          <span class="ecosystem-bar__name">Kahane Coaching</span>
        </a>
      </div>
    </nav>

    <header class="site-nav" role="banner">
      <div class="container">
        <nav class="site-nav__inner" aria-label="Primary navigation">
          <a href="/" class="site-nav__brand">Kahane <span>Coaching</span></a>
          <ul class="site-nav__links" role="list">
            <li><a href="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a></li>
            <li><a href="/coaching" aria-current={isActive("/coaching") ? "page" : undefined}>Coaching</a></li>
            <li><a href="/relationships" aria-current={isActive("/relationships") ? "page" : undefined}>Relationships</a></li>
            <li><a href="/communications" aria-current={isActive("/communications") ? "page" : undefined}>Communication</a></li>
            <li><a href="/events" aria-current={isActive("/events") ? "page" : undefined}>Events</a></li>
            <li><a href="/writing" aria-current={isActive("/writing") ? "page" : undefined}>Writing</a></li>
            <li><a href="/contact" aria-current={isActive("/contact") ? "page" : undefined}>Contact</a></li>
          </ul>
          <a href="/contact" class="site-nav__cta">Start a Conversation</a>
          <button
            class="site-nav__toggle"
            aria-label="Open menu"
            aria-expanded="false"
            id="mobile-toggle"
          >
            <span></span><span></span><span></span>
          </button>
        </nav>
      </div>
    </header>

    <div class="mobile-overlay" id="mobileOverlay">
      <div class="mobile-menu">
        <a href="/about">About</a>
        <a href="/coaching">Coaching</a>
        <a href="/relationships">Relationships</a>
        <a href="/communications">Communication</a>
        <a href="/events">Events</a>
        <a href="/writing">Writing</a>
        <a href="/contact">Contact</a>
        <a href="/contact" class="mobile-cta">Start a Conversation</a>
      </div>
    </div>

    <main id="main-content">
      <slot />
    </main>

    <GlobalFooter />

    <script>
      const toggle = document.getElementById('mobile-toggle');
      const overlay = document.getElementById('mobileOverlay');

      if (toggle && overlay) {
        toggle.addEventListener('click', () => {
          const isOpen = overlay.classList.contains('open');
          overlay.classList.toggle('open', !isOpen);
          toggle.classList.toggle('open', !isOpen);
          toggle.setAttribute('aria-expanded', String(!isOpen));
          toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
          document.body.style.overflow = isOpen ? '' : 'hidden';
        });

        overlay.addEventListener('click', (e) => {
          if (!(e.target as Element).closest('.mobile-menu')) {
            overlay.classList.remove('open');
            toggle.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', 'Open menu');
            document.body.style.overflow = '';
          }
        });
      }
    </script>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
    </script>

  </body>
</html>