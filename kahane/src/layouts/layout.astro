---
// Layout.astro — Kahane Coaching
// Matches the approved design at kahane-coaching.vercel.app
// Design system: forest green (PMS 5467), Playfair Display body, translucent green bg

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Christine Kahane, NBC-HWC — Executive, Health & Wellness, and Divorce Coaching grounded in 25 years of communication science.",
  ogImage = "/og-default.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Active nav detection
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title} | Kahane Coaching</title>

    <!-- Fonts: Playfair Display (body/serif) + DM Sans (nav/UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* ============================================================
         DESIGN TOKENS — Kahane Coaching
         PMS 5467: deep, unsaturated forest green
         Translucent wash for backgrounds, full-sat for headlines
         ============================================================ */

      :root {
        /* Core green — PMS 5467 */
        --green-900: #1e3028;   /* deepest, near-black green */
        --green-800: #2a4035;   /* very dark, nav/footer bg */
        --green-700: #33503f;   /* primary headline color */
        --green-600: #3d6149;   /* slightly lighter headline alt */
        --green-500: #4a7358;   /* mid green, accents */
        --green-400: #6a9a7a;   /* soft green, borders/dividers */
        --green-200: #c5d9cc;   /* pale green tint */
        --green-100: #e8f0eb;   /* near-white green wash */
        --green-50:  #f4f7f5;   /* off-white background base */

        /* Background system — translucent green washes */
        --bg-page:         #f2f5f3;   /* base page: near-white with green cast */
        --bg-section-alt:  rgba(42, 64, 53, 0.04);   /* alternate section wash */
        --bg-card:         rgba(255, 255, 255, 0.72); /* frosted white cards */
        --bg-card-border:  rgba(61, 97, 73, 0.14);    /* subtle green card border */
        --bg-dark:         var(--green-800);           /* dark sections */
        --bg-dark-deeper:  var(--green-900);           /* footer */

        /* Typography */
        --font-serif:  'Playfair Display', Georgia, 'Times New Roman', serif;
        --font-sans:   'DM Sans', system-ui, sans-serif;

        /* Text colors */
        --text-headline:  var(--green-700);   /* all headlines: forest green */
        --text-body:      #2c3830;            /* body: very dark green-tinted */
        --text-muted:     #5a6e62;            /* secondary/muted text */
        --text-eyebrow:   var(--green-500);   /* labels/eyebrows above sections */
        --text-on-dark:   #e8f0eb;            /* body text on dark green bg */
        --text-on-dark-muted: rgba(232, 240, 235, 0.65);

        /* Accent / CTA */
        --accent:         var(--green-700);
        --accent-hover:   var(--green-900);
        --accent-light:   var(--green-100);

        /* Type scale */
        --text-xs:   0.75rem;    /* 12px */
        --text-sm:   0.875rem;   /* 14px */
        --text-base: 1rem;       /* 16px */
        --text-lg:   1.125rem;   /* 18px */
        --text-xl:   1.25rem;    /* 20px */
        --text-2xl:  1.5rem;     /* 24px */
        --text-3xl:  1.875rem;   /* 30px */
        --text-4xl:  2.25rem;    /* 36px */
        --text-5xl:  3rem;       /* 48px */
        --text-6xl:  3.75rem;    /* 60px */

        /* Spacing */
        --space-1:   0.25rem;
        --space-2:   0.5rem;
        --space-3:   0.75rem;
        --space-4:   1rem;
        --space-6:   1.5rem;
        --space-8:   2rem;
        --space-10:  2.5rem;
        --space-12:  3rem;
        --space-16:  4rem;
        --space-20:  5rem;
        --space-24:  6rem;
        --space-32:  8rem;

        /* Layout */
        --max-width:       1120px;
        --max-width-prose: 680px;
        --section-pad-y:   var(--space-24);

        /* Borders & radius */
        --radius-sm:  4px;
        --radius-md:  8px;
        --radius-lg:  16px;
        --border-subtle: 1px solid rgba(61, 97, 73, 0.15);

        /* Transitions */
        --transition-fast:   150ms ease;
        --transition-base:   250ms ease;
        --transition-slow:   400ms ease;

        /* Shadows */
        --shadow-sm:  0 1px 3px rgba(30, 48, 40, 0.08);
        --shadow-md:  0 4px 16px rgba(30, 48, 40, 0.10);
        --shadow-lg:  0 12px 40px rgba(30, 48, 40, 0.14);
      }

      /* ============================================================
         RESET & BASE
         ============================================================ */

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 16px;
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      body {
        font-family: var(--font-sans);
        font-size: var(--text-base);
        line-height: 1.65;
        color: var(--text-body);
        background-color: var(--bg-page);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
      }

      /* ============================================================
         TYPOGRAPHY DEFAULTS
         ============================================================ */

      /* All body copy uses Playfair — per Christine's direction */
      p, li, blockquote, td, th {
        font-family: var(--font-serif);
        font-size: var(--text-lg);
        line-height: 1.75;
        color: var(--text-body);
      }

      /* Headlines use DM Sans for structure, colored green */
      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-sans);
        font-weight: 600;
        line-height: 1.2;
        color: var(--text-headline);
        letter-spacing: -0.01em;
      }

      h1 { font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl)); font-weight: 300; letter-spacing: -0.02em; }
      h2 { font-size: clamp(var(--text-3xl), 3.5vw, var(--text-4xl)); font-weight: 400; }
      h3 { font-size: var(--text-2xl); font-weight: 500; }
      h4 { font-size: var(--text-xl); font-weight: 500; }
      h5 { font-size: var(--text-lg); font-weight: 600; }
      h6 { font-size: var(--text-base); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }

      /* Italic in headlines uses Playfair for elegance */
      h1 em, h2 em {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: 400;
        color: var(--green-600);
      }

      a {
        color: var(--text-headline);
        text-decoration: none;
        transition: color var(--transition-fast);
      }

      a:hover {
        color: var(--accent-hover);
      }

      strong {
        font-weight: 600;
      }

      blockquote {
        border-left: 3px solid var(--green-400);
        padding-left: var(--space-6);
        margin: var(--space-8) 0;
        font-size: var(--text-xl);
        font-style: italic;
        color: var(--text-muted);
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      /* ============================================================
         LAYOUT UTILITIES
         ============================================================ */

      .container {
        width: 100%;
        max-width: var(--max-width);
        margin-inline: auto;
        padding-inline: var(--space-6);
      }

      @media (min-width: 768px) {
        .container {
          padding-inline: var(--space-8);
        }
      }

      @media (min-width: 1200px) {
        .container {
          padding-inline: var(--space-12);
        }
      }

      .section {
        padding-block: var(--section-pad-y);
      }

      .section--alt {
        background-color: var(--bg-section-alt);
      }

      .section--dark {
        background-color: var(--bg-dark);
        color: var(--text-on-dark);
      }

      .section--dark h1,
      .section--dark h2,
      .section--dark h3,
      .section--dark h4 {
        color: var(--green-100);
      }

      .section--dark p,
      .section--dark li {
        color: var(--text-on-dark);
      }

      /* ============================================================
         EYEBROW / LABEL STYLES
         ============================================================ */

      .eyebrow {
        font-family: var(--font-sans);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-eyebrow);
        display: block;
        margin-bottom: var(--space-3);
      }

      /* ============================================================
         BUTTON SYSTEM
         ============================================================ */

      .btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: 0.75rem 1.75rem;
        border-radius: var(--radius-sm);
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        font-weight: 500;
        letter-spacing: 0.02em;
        text-decoration: none;
        cursor: pointer;
        transition: all var(--transition-base);
        border: 1.5px solid transparent;
        line-height: 1;
        white-space: nowrap;
      }

      .btn--primary {
        background-color: var(--green-700);
        color: #f4f7f5;
        border-color: var(--green-700);
      }

      .btn--primary:hover {
        background-color: var(--green-900);
        border-color: var(--green-900);
        color: #f4f7f5;
        transform: translateY(-1px);
        box-shadow: var(--shadow-md);
      }

      .btn--outline {
        background-color: transparent;
        color: var(--green-700);
        border-color: var(--green-400);
      }

      .btn--outline:hover {
        background-color: var(--green-100);
        border-color: var(--green-700);
        color: var(--green-900);
      }

      .btn--ghost {
        background-color: transparent;
        color: var(--text-muted);
        padding-inline: var(--space-4);
      }

      .btn--ghost:hover {
        color: var(--text-headline);
      }

      /* On dark backgrounds */
      .btn--primary-light {
        background-color: var(--green-100);
        color: var(--green-900);
        border-color: var(--green-100);
      }

      .btn--primary-light:hover {
        background-color: #fff;
        color: var(--green-900);
      }

      .btn--outline-light {
        background-color: transparent;
        color: var(--green-100);
        border-color: rgba(197, 217, 204, 0.4);
      }

      .btn--outline-light:hover {
        background-color: rgba(197, 217, 204, 0.1);
        border-color: var(--green-200);
      }

      /* ============================================================
         CARD SYSTEM
         ============================================================ */

      .card {
        background: var(--bg-card);
        border: var(--border-subtle);
        border-radius: var(--radius-md);
        padding: var(--space-8);
        box-shadow: var(--shadow-sm);
      }

      .card--bordered {
        background: transparent;
        border: 1px solid var(--bg-card-border);
        border-radius: var(--radius-md);
        padding: var(--space-8);
      }

      /* ============================================================
         DIVIDER
         ============================================================ */

      .divider {
        border: none;
        border-top: var(--border-subtle);
        margin-block: var(--space-8);
      }

      /* ============================================================
         PROSE (rich text areas)
         ============================================================ */

      .prose {
        max-width: var(--max-width-prose);
      }

      .prose p {
        margin-bottom: var(--space-6);
      }

      .prose h2 {
        margin-top: var(--space-12);
        margin-bottom: var(--space-4);
      }

      .prose h3 {
        margin-top: var(--space-8);
        margin-bottom: var(--space-3);
      }

      .prose ul, .prose ol {
        padding-left: var(--space-6);
        margin-bottom: var(--space-6);
      }

      .prose li {
        margin-bottom: var(--space-2);
      }

      /* ============================================================
         NAVIGATION
         ============================================================ */

      .site-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(242, 245, 243, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(61, 97, 73, 0.10);
      }

      .site-nav__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
        gap: var(--space-8);
      }

      .site-nav__brand {
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--text-headline);
        text-decoration: none;
        flex-shrink: 0;
      }

      .site-nav__brand:hover {
        color: var(--green-900);
      }

      .site-nav__links {
        display: none;
        list-style: none;
        gap: var(--space-8);
      }

      @media (min-width: 960px) {
        .site-nav__links {
          display: flex;
        }
      }

      .site-nav__links a {
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        font-weight: 400;
        color: var(--text-muted);
        text-decoration: none;
        transition: color var(--transition-fast);
        padding-block: var(--space-2);
        border-bottom: 1.5px solid transparent;
      }

      .site-nav__links a:hover,
      .site-nav__links a[aria-current="page"] {
        color: var(--text-headline);
        border-bottom-color: var(--green-400);
      }

      .site-nav__cta {
        flex-shrink: 0;
        display: none;
      }

      @media (min-width: 640px) {
        .site-nav__cta {
          display: block;
        }
      }

      /* Mobile menu toggle */
      .site-nav__toggle {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 32px;
        height: 32px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
      }

      @media (min-width: 960px) {
        .site-nav__toggle {
          display: none;
        }
      }

      .site-nav__toggle span {
        display: block;
        width: 22px;
        height: 1.5px;
        background: var(--text-headline);
        transition: all var(--transition-base);
        transform-origin: center;
      }

      /* Mobile menu drawer */
      .site-nav__mobile {
        display: none;
        background: var(--bg-page);
        border-top: var(--border-subtle);
        padding: var(--space-6);
      }

      .site-nav__mobile.is-open {
        display: block;
      }

      .site-nav__mobile ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        margin-bottom: var(--space-6);
      }

      .site-nav__mobile a {
        display: block;
        font-family: var(--font-sans);
        font-size: var(--text-base);
        color: var(--text-muted);
        padding-block: var(--space-3);
        border-bottom: var(--border-subtle);
        transition: color var(--transition-fast);
      }

      .site-nav__mobile a:hover {
        color: var(--text-headline);
      }

      /* ============================================================
         ECOSYSTEM SWITCHER (top bar — matches mockup)
         ============================================================ */

      .ecosystem-bar {
        background: var(--green-900);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        padding-block: var(--space-2);
        overflow-x: auto;
      }

      .ecosystem-bar__inner {
        display: flex;
        align-items: center;
        gap: var(--space-6);
        min-width: max-content;
      }

      .ecosystem-bar__item {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-sm);
        transition: background var(--transition-fast);
      }

      .ecosystem-bar__item:hover {
        background: rgba(255,255,255,0.06);
      }

      .ecosystem-bar__item--active {
        background: rgba(197, 217, 204, 0.12);
      }

      .ecosystem-bar__label {
        font-family: var(--font-sans);
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(197, 217, 204, 0.5);
        line-height: 1.2;
      }

      .ecosystem-bar__name {
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--green-100);
        line-height: 1.3;
      }

      /* ============================================================
         FOOTER
         ============================================================ */

      .site-footer {
        background: var(--green-900);
        color: var(--text-on-dark);
        padding-block: var(--space-16) var(--space-8);
      }

      .site-footer__grid {
        display: grid;
        gap: var(--space-12);
        margin-bottom: var(--space-12);
      }

      @media (min-width: 768px) {
        .site-footer__grid {
          grid-template-columns: 2fr 1fr 1fr;
        }
      }

      .site-footer__brand {
        font-family: var(--font-sans);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.10em;
        text-transform: uppercase;
        color: var(--green-400);
        margin-bottom: var(--space-4);
        display: block;
      }

      .site-footer__tagline {
        font-family: var(--font-serif);
        font-size: var(--text-base);
        color: var(--text-on-dark-muted);
        line-height: 1.6;
        margin-bottom: 0;
      }

      .site-footer__heading {
        font-family: var(--font-sans);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.10em;
        text-transform: uppercase;
        color: var(--green-400);
        margin-bottom: var(--space-4);
      }

      .site-footer__links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }

      .site-footer__links a {
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        color: var(--text-on-dark-muted);
        text-decoration: none;
        transition: color var(--transition-fast);
      }

      .site-footer__links a:hover {
        color: var(--green-100);
      }

      .site-footer__bottom {
        border-top: 1px solid rgba(255,255,255,0.08);
        padding-top: var(--space-6);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-4);
      }

      .site-footer__legal {
        font-family: var(--font-sans);
        font-size: var(--text-xs);
        color: var(--text-on-dark-muted);
      }

      /* ============================================================
         FOCUS & ACCESSIBILITY
         ============================================================ */

      :focus-visible {
        outline: 2px solid var(--green-500);
        outline-offset: 3px;
        border-radius: var(--radius-sm);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      /* ============================================================
         SCROLL ANIMATION UTILITIES
         ============================================================ */

      .fade-up {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }

      .fade-up.is-visible {
        opacity: 1;
        transform: translateY(0);
      }
    </style>
  </head>

  <body>
    <!-- Ecosystem switcher bar (matches the mockup top nav) -->
    <div class="ecosystem-bar">
      <div class="container">
        <div class="ecosystem-bar__inner">
          <a
            href="https://institute-unlearning.vercel.app/"
            class="ecosystem-bar__item"
          >
            <span class="ecosystem-bar__label">The Master Brand</span>
            <span class="ecosystem-bar__name">The Institute</span>
          </a>
          <a
            href="https://coherence-company.vercel.app/"
            class="ecosystem-bar__item"
          >
            <span class="ecosystem-bar__label">B2B / Organizations</span>
            <span class="ecosystem-bar__name">The Coherence Co.</span>
          </a>
          <a
            href="/"
            class="ecosystem-bar__item ecosystem-bar__item--active"
          >
            <span class="ecosystem-bar__label">B2C / Individuals</span>
            <span class="ecosystem-bar__name">Kahane Coaching</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Primary navigation -->
    <header class="site-nav" role="banner">
      <div class="container">
        <nav class="site-nav__inner" aria-label="Primary navigation">
          <a href="/" class="site-nav__brand">Kahane Coaching</a>

          <ul class="site-nav__links" role="list">
            <li>
              <a href="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a>
            </li>
            <li>
              <a href="/coaching" aria-current={isActive("/coaching") ? "page" : undefined}>Coaching</a>
            </li>
            <li>
              <a href="/relationships" aria-current={isActive("/relationships") ? "page" : undefined}>Relationships</a>
            </li>
            <li>
              <a href="/community" aria-current={isActive("/community") ? "page" : undefined}>Community</a>
            </li>
            <li>
              <a href="/events" aria-current={isActive("/events") ? "page" : undefined}>Events</a>
            </li>
            <li>
              <a href="/writing" aria-current={isActive("/writing") ? "page" : undefined}>Writing</a>
            </li>
            <li>
              <a href="/contact" aria-current={isActive("/contact") ? "page" : undefined}>Contact</a>
            </li>
          </ul>

          <div class="site-nav__cta">
            <a href="/contact" class="btn btn--primary">Start a Conversation</a>
          </div>

          <!-- Mobile toggle -->
          <button
            class="site-nav__toggle"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            id="mobile-toggle"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </nav>
