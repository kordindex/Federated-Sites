<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Playfair Display';
    --aw-font-heading: 'Playfair Display';

    /* JUST the numbers, no rgb() */
    --aw-color-primary: 19 41 75;     /* PMS 2767 navy */
    --aw-color-secondary: 196 146 42; /* PMS 1245 gold */
    --aw-color-accent: 196 146 42;    /* gold */

    --aw-color-text-heading: 19 41 75;
    --aw-color-text-default: 44 58 74;
    --aw-color-text-muted: 107 122 141;

    --aw-color-bg-page: 250 248 245;
    --aw-color-bg-page-dark: 250 248 245;

    ::selection {
      background-color: rgb(196 146 42); /* rgb() is fine here in raw CSS */
      color: white;
    }
  }
  
  /* Do the same for the .dark block below */
  .dark {
    --aw-color-primary: 19 41 75;
    --aw-color-secondary: 196 146 42;
    --aw-color-accent: 196 146 42;
    --aw-color-text-heading: 19 41 75;
    --aw-color-text-default: 44 58 74;
    --aw-color-bg-page: 250 248 245;
  }
</style>