---
import Layout from '~/layouts/CanvasLayout.astro';

const metadata = {
  title: 'Coherence Canvas — The Coherence Co.',
  description: 'Map your system\'s response to pressure across nine structural domains. Select a block to explore how pressure expresses inside your organization.',
};
---

<Layout metadata={metadata}>

  <div class="page">

    <div class="page-header">
      <span class="page-label">The Coherence Co. — Interactive Canvas</span>
      <h1 class="page-title">When urgency increases,<br>what changes first?</h1>
      <p class="page-subtitle">Signal clarity? Belonging? Decision discipline? Map your system's response to pressure in minutes.</p>
      <p class="page-instruction"><span>Select a block</span> to explore how pressure expresses inside your system.</p>
    </div>

    <div class="grid-wrapper">
      <div class="row-labels">
        <div class="row-label"><span>Sense</span></div>
        <div class="row-label"><span>Decide</span></div>
        <div class="row-label"><span>Act</span></div>
      </div>
      <div class="canvas-grid" id="canvasGrid"></div>
    </div>

  </div>

  <div class="modal-overlay" id="modalOverlay">
    <div class="modal" id="modal">
      <button class="modal-close" id="modalClose">×</button>
      <div class="modal-header">
        <span class="modal-label" id="modalLabel"></span>
        <h2 class="modal-title" id="modalTitle"></h2>
        <p class="modal-intro">Answer three short prompts to see how pressure expresses in this area.</p>
      </div>

      <div class="progress-wrap">
        <div class="progress-bar">
          <div class="progress-fill" id="progressFill" style="width: 33%"></div>
        </div>
        <div class="progress-text">
          <span>Diagnostic</span>
          <span id="progressText">Question 1 of 3</span>
        </div>
      </div>

      <div id="questionView">
        <div class="question-wrap">
          <span class="question-category" id="questionCategory"></span>
          <p class="question-text" id="questionText"></p>
          <div class="options" id="optionsContainer"></div>
        </div>
        <div class="modal-nav">
          <button class="btn btn-ghost" id="prevBtn" disabled>← Previous</button>
          <button class="btn btn-primary" id="nextBtn" disabled>Next →</button>
        </div>
      </div>

      <div id="resultsView" style="display:none;">
        <div class="results-wrap">
          <span class="results-eyebrow">Escalation Mirror</span>
          <p class="results-framing">"You are not experiencing dysfunction. You are seeing how pressure is currently metabolized."</p>
          <span class="cluster-label">Your signal cluster</span>
          <h3 class="cluster-name" id="clusterName"></h3>
          <p class="mirror-text" id="mirrorText"></p>
          <div class="lever-wrap">
            <span class="lever-label">Coherence Shift</span>
            <p class="lever-intro">Coherence restores when…</p>
            <p class="lever-text" id="leverText"></p>
          </div>
          <div class="cta-divider"></div>
          <p class="cta-soft">Would you like a full structural calibration?</p>
          <a class="btn-cta" href="/essential-diagnostic">Explore the Essential Coherence Diagnostic</a>
          <button class="btn-restart" id="restartBtn">↩ Explore another block</button>
        </div>
      </div>

    </div>
  </div>

</Layout>

<style is:global>
  /* ─── Canvas Tailwind reset overrides ──────────────────────────────────── */
  .canvas-grid, .canvas-grid * { box-sizing: border-box; }
  .block { display: flex !important; }
  .block-hover { display: flex !important; }
  .canvas-grid { display: grid !important; }
  .grid-wrapper { display: grid !important; }
  .options { display: flex !important; }
  .option { display: flex !important; width: 100% !important; }
  .modal-overlay { display: flex !important; }
  .modal-nav { display: flex !important; }
  .progress-text { display: flex !important; }
  .results-wrap, .question-wrap, .modal-header { display: block !important; }
  .btn, .btn-cta, .btn-restart, .modal-close { font-family: 'Inter', sans-serif !important; }

  /* ─── Variables ─────────────────────────────────────────────────────────── */
  :root {
    --navy:        #13294B;
    --navy-deep:   #F0EDE8;
    --navy-mid:    #FAF8F5;
    --navy-light:  #F5F2EC;
    --gold:        #C4922A;
    --gold-light:  #D4A84B;
    --gold-dim:    rgba(196, 146, 42, 0.08);
    --white:       #13294B;
    --slate:       #2C3A4A;
    --slate-dim:   rgba(44, 58, 74, 0.65);
    --border:      rgba(19, 41, 75, 0.12);
    --border-gold: rgba(196, 146, 42, 0.3);

    /* Modal keeps dark for contrast and readability */
    --modal-bg:        #152033;
    --modal-bg-deep:   #0f1623;
    --modal-white:     #ffffff;
    --modal-slate:     #d0d4db;
    --modal-slate-dim: rgba(208, 212, 219, 0.55);
    --modal-border:    rgba(255, 255, 255, 0.08);
  }

  /* ─── Page background — light ───────────────────────────────────────────── */
  body { background-color: #FAF8F5 !important; }

  /* ─── Page ──────────────────────────────────────────────────────────────── */
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 180px 2rem 120px;
    color: var(--slate);
    font-family: 'Inter', sans-serif;
  }

  /* ─── Header ────────────────────────────────────────────────────────────── */
  .page-header { margin-bottom: 64px; }

  .page-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
    display: block;
  }

  .page-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--slate-dim);
    max-width: 560px;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .page-instruction {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--slate-dim);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .page-instruction span { color: var(--gold); }

  /* ─── Row Labels ────────────────────────────────────────────────────────── */
  .grid-wrapper {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 0 16px;
  }

  .row-labels {
    display: flex;
    flex-direction: column;
  }

  .row-label {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .row-label span {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--slate-dim);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  /* ─── Grid ──────────────────────────────────────────────────────────────── */
  .canvas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  /* ─── Block — light palette ─────────────────────────────────────────────── */
  .block {
    background: #ffffff;
    padding: 2rem;
    min-height: 180px;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: background 0.3s ease;
    overflow: hidden;
    cursor: pointer;
  }

  .block:hover { background: var(--navy-deep); }
  .block:hover .block-hover { opacity: 1; transform: translateY(0); }
  .block:hover .block-meta { opacity: 0; }

  .block-num {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--gold);
    margin-bottom: 0.75rem;
    display: block;
  }

  .block-title {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .block-sub {
    font-size: 0.72rem;
    color: var(--slate-dim);
    line-height: 1.5;
  }

  .block-meta { transition: opacity 0.25s ease; }

  .block-hover {
    position: absolute;
    inset: 0;
    padding: 2rem;
    background: var(--navy);
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    border: 1px solid var(--border-gold);
  }

  .block-hover-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }

  .block-hover-q {
    font-family: 'Playfair Display', serif;
    font-size: 0.95rem;
    font-style: italic;
    color: #ffffff;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .block-hover-cta {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .block-hover-cta::after { content: '→'; transition: transform 0.2s; }
  .block:hover .block-hover-cta::after { transform: translateX(4px); }

  .block.completed::after {
    content: '✓';
    position: absolute;
    top: 1rem; right: 1rem;
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--gold);
    opacity: 0.6;
  }

  /* ─── Modal — stays dark for readability ────────────────────────────────── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 15, 25, 0.88);
    backdrop-filter: blur(12px);
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .modal-overlay.open { opacity: 1; pointer-events: all; }

  .modal {
    background: var(--modal-bg);
    border: 1px solid var(--border-gold);
    width: 100%;
    max-width: 640px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }

  .modal-overlay.open .modal { transform: translateY(0); }

  .modal-header {
    padding: 2rem 2rem 1.5rem;
    border-bottom: 1px solid var(--modal-border);
    margin-bottom: 2rem;
  }

  .modal-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.5rem;
    display: block;
  }

  .modal-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: var(--modal-white);
    font-weight: 700;
  }

  .modal-intro {
    font-size: 0.85rem;
    color: var(--modal-slate-dim);
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  .modal-close {
    position: absolute;
    top: 1.25rem; right: 1.25rem;
    background: none;
    border: none;
    color: var(--modal-slate-dim);
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s;
    padding: 4px;
  }

  .modal-close:hover { color: var(--modal-white); }

  .progress-wrap { padding: 0 2rem; margin-bottom: 2rem; }

  .progress-bar {
    height: 2px;
    background: var(--modal-border);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 0.6rem;
  }

  .progress-fill {
    height: 100%;
    background: var(--gold);
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .progress-text {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--modal-slate-dim);
  }

  .question-wrap { padding: 0 2rem 2rem; }

  .question-category {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
    display: block;
  }

  .question-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    color: var(--modal-white);
    line-height: 1.4;
    margin-bottom: 1.75rem;
    font-weight: 400;
  }

  .options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .option {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--modal-border);
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    text-align: left;
    width: 100%;
    font-family: 'Inter', sans-serif;
  }

  .option:hover { border-color: rgba(196, 146, 42, 0.4); background: rgba(196, 146, 42, 0.04); }
  .option.selected { border-color: var(--gold); background: rgba(196, 146, 42, 0.08); }

  .option-letter {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--gold);
    opacity: 0.5;
    min-width: 1.25rem;
    padding-top: 1px;
    transition: opacity 0.2s;
  }

  .option.selected .option-letter { opacity: 1; }

  .option-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--modal-white);
    margin-bottom: 0.3rem;
  }

  .option-sub {
    font-size: 0.78rem;
    color: var(--modal-slate-dim);
    line-height: 1.5;
  }

  .modal-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    border-top: 1px solid var(--modal-border);
    gap: 1rem;
  }

  .btn {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.75rem 1.75rem;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Inter', sans-serif;
  }

  .btn-primary { background: var(--gold); color: #ffffff; }
  .btn-primary:hover { background: var(--gold-light); }
  .btn-primary:disabled { opacity: 0.3; cursor: not-allowed; }
  .btn-primary:disabled:hover { background: var(--gold); }

  .btn-ghost { background: transparent; color: var(--modal-slate-dim); border: 1px solid var(--modal-border); }
  .btn-ghost:hover { color: var(--modal-white); border-color: rgba(255,255,255,0.2); }
  .btn-ghost:disabled { opacity: 0.2; cursor: not-allowed; }

  .results-wrap { padding: 0 2rem 2rem; }

  .results-eyebrow {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.5rem;
    display: block;
  }

  .results-framing {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-style: italic;
    color: var(--modal-slate);
    line-height: 1.6;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--modal-border);
  }

  .cluster-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.5rem;
    display: block;
  }

  .cluster-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    color: var(--modal-white);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .mirror-text {
    font-size: 0.9rem;
    color: var(--modal-slate);
    line-height: 1.75;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--modal-border);
  }

  .lever-wrap {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--modal-border);
  }

  .lever-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--modal-slate-dim);
    margin-bottom: 0.5rem;
    display: block;
  }

  .lever-intro { font-size: 0.8rem; color: var(--modal-slate-dim); margin-bottom: 0.5rem; }

  .lever-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    color: var(--gold);
    font-style: italic;
    line-height: 1.5;
  }

  .cta-divider {
    width: 40px;
    height: 1px;
    background: var(--border-gold);
    margin: 0 auto 1.5rem;
  }

  .cta-soft { font-size: 0.8rem; color: var(--modal-slate-dim); text-align: center; margin-bottom: 1rem; }

  .btn-cta {
    display: block;
    width: 100%;
    background: transparent;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 1rem;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s ease;
    text-align: center;
    text-decoration: none;
  }

  .btn-cta:hover { background: var(--gold); color: #ffffff; }

  .btn-restart {
    display: block;
    width: 100%;
    background: transparent;
    border: 1px solid var(--modal-border);
    color: var(--modal-slate-dim);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.75rem;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s ease;
    margin-top: 0.75rem;
    text-align: center;
  }

  .btn-restart:hover { color: var(--modal-white); border-color: rgba(255,255,255,0.2); }

  @media (max-width: 680px) {
    .page { padding-top: 150px; }
    .grid-wrapper { grid-template-columns: 1fr; }
    .row-labels { display: none; }
    .canvas-grid { grid-template-columns: 1fr; }
    .block { min-height: 120px; }
    .modal { max-height: 100vh; border-left: none; border-right: none; }
    .modal-overlay { padding: 0; align-items: flex-end; }
  }
</style>

<script>
  const blocks = [
    {
      id: 1, title: "Leadership Integrity", sub: "How authority behaves under pressure.",
      hover: "When pressure rises, does authority stabilize — or tighten?",
      questions: [
        { category: "When significant resistance appears", text: "When significant resistance appears:", options: [
          { letter: "A", title: "Dialogue widens before decisions narrow", sub: "We pause to hear before we direct.", cluster: "early" },
          { letter: "B", title: "Authority clarifies direction with limited consultation", sub: "We check in selectively before moving.", cluster: "mid" },
          { letter: "C", title: "Authority consolidates quickly to prevent drift", sub: "We move decisively to hold the line.", cluster: "late" }
        ]},
        { category: "When performance dips", text: "When performance dips:", options: [
          { letter: "A", title: "Root causes are explored systemically", sub: "We investigate structure before assigning accountability.", cluster: "early" },
          { letter: "B", title: "Accountability conversations intensify", sub: "We apply pressure to individuals or teams.", cluster: "mid" },
          { letter: "C", title: "Urgency increases and tone sharpens", sub: "We push harder and faster.", cluster: "late" }
        ]},
        { category: "Under sustained strain", text: "Under sustained strain:", options: [
          { letter: "A", title: "Leaders regulate tone intentionally", sub: "We model steadiness even when pressure is high.", cluster: "early" },
          { letter: "B", title: "Leaders push harder toward resolution", sub: "We increase effort and expect others to match it.", cluster: "mid" },
          { letter: "C", title: "Leaders equate intensity with commitment", sub: "We read urgency as dedication.", cluster: "late" }
        ]}
      ],
      results: {
        early: { name: "Early-Stage Escalation Signals", mirror: "Leadership pressure is being metabolized through increased vigilance. Dialogue remains open, but urgency is rising. The system is holding — and the holding is not accidental. It requires intention to maintain.", lever: "…pacing slows before authority narrows." },
        mid: { name: "Mid-Stage Escalation Signals", mirror: "Authority is tightening under strain. Direction is clarifying, but consultation bandwidth is narrowing. This is not failure — it is structural reflex. The question is whether the tightening is intentional or automatic.", lever: "…clarity is separated from compression." },
        late: { name: "Late-Stage Escalation Signals", mirror: "Intensity is substituting for containment. Pressure is beginning to define tone rather than strategy. When leaders equate urgency with commitment, the system loses its capacity to self-regulate.", lever: "…tone is regulated before outcome is directed." }
      }
    },
    {
      id: 2, title: "Signal Clarity", sub: "How clarity behaves under urgency.",
      hover: "Does urgency increase clarity — or distort it?",
      questions: [
        { category: "When deadlines tighten", text: "When deadlines tighten:", options: [
          { letter: "A", title: "Assumptions are revisited", sub: "We pause to clarify before accelerating.", cluster: "early" },
          { letter: "B", title: "Execution accelerates with partial validation", sub: "We push forward while adjusting on the move.", cluster: "mid" },
          { letter: "C", title: "Validation drops in favor of speed", sub: "We accelerate decisions without full validation.", cluster: "late" }
        ]},
        { category: "During high-stakes decisions", text: "During high-stakes decisions:", options: [
          { letter: "A", title: "Documentation precedes commitment", sub: "Assumptions are written down before we move.", cluster: "early" },
          { letter: "B", title: "Verbal alignment replaces formal review", sub: "We reach agreement in conversation, not documentation.", cluster: "mid" },
          { letter: "C", title: "Decisions are finalized in compressed loops", sub: "We move fast and formalize afterward, if at all.", cluster: "late" }
        ]},
        { category: "After major calls", text: "After major calls:", options: [
          { letter: "A", title: "Structured review follows", sub: "We intentionally examine what happened and why.", cluster: "early" },
          { letter: "B", title: "Informal reflection occurs", sub: "We talk about it loosely but don't capture it.", cluster: "mid" },
          { letter: "C", title: "The team moves immediately to next priority", sub: "There is no review — momentum continues.", cluster: "late" }
        ]}
      ],
      results: {
        early: { name: "Early-Stage Escalation Signals", mirror: "Clarity is holding, but pressure is building around validation discipline. Your system is absorbing urgency without significant distortion — but the conditions for drift are present. The gap between pace and comprehension is narrow. It does not need to widen.", lever: "…assumptions are documented before mobilization." },
        mid: { name: "Mid-Stage Escalation Signals", mirror: "Signal quality is fluctuating as pace increases. Your system is moving faster than it is confirming — decisions are being made with partial validation, and the gap between what is broadcast and what is understood is beginning to widen. This is not dysfunction. It is structural reflex under load.", lever: "…validation gates are reintroduced before the next commitment." },
        late: { name: "Late-Stage Escalation Signals", mirror: "Velocity is beginning to outpace coherence. Your system has normalized acceleration to the point where validation has become an afterthought. The cost is not visible yet — but it is accumulating. Narrative debt compounds quietly. Trust thins before it breaks.", lever: "…acceleration pauses until assumptions are surfaced and shared." }
      }
    },
    {
      id: 3, title: "Relational Coherence", sub: "How belonging responds to dissent.",
      hover: "When dissent appears, does belonging widen — or narrow?",
      questions: [
        { category: "When someone challenges strategy", text: "When someone challenges strategy:", options: [
