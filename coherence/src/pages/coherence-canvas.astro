  let currentBlock = null;
  let currentQ = 0;
  let answers = [];
  let completedBlocks = new Set();

  function renderGrid() {
    const grid = document.getElementById('canvasGrid');
    if (!grid) return;
    grid.innerHTML = blocks.map(b => `
      <div class="block${completedBlocks.has(b.id) ? ' completed' : ''}" data-block-id="${b.id}">
        <span class="block-num">0${b.id}</span>
        <div class="block-meta">
          <h3 class="block-title">${b.title}</h3>
          <p class="block-sub">${b.sub}</p>
        </div>
        <div class="block-hover">
          <span class="block-hover-label">Explore this block</span>
          <p class="block-hover-q">"${b.hover}"</p>
          <span class="block-hover-cta">Begin micro-diagnostic</span>
        </div>
      </div>
    `).join('');

    grid.querySelectorAll('.block').forEach(el => {
      el.addEventListener('click', () => openModal(parseInt(el.dataset.blockId)));
    });
  }

  function openModal(blockId) {
    currentBlock = blocks.find(b => b.id === blockId);
    resetState();
    document.getElementById('modalLabel').textContent = `${currentBlock.title} — Micro-Diagnostic`;
    document.getElementById('modalTitle').textContent = currentBlock.title;
    renderQuestion();
    document.getElementById('modalOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('modalOverlay').classList.remove('open');
    document.body.style.overflow = '';
  }

  function resetState() {
    currentQ = 0;
    answers = [];
    document.getElementById('questionView').style.display = 'block';
    document.getElementById('resultsView').style.display = 'none';
  }

  function renderQuestion() {
    const q = currentBlock.questions[currentQ];
    const progress = ((currentQ + 1) / 3) * 100;
    document.getElementById('progressFill').style.width = progress + '%';
    document.getElementById('progressText').textContent = `Question ${currentQ + 1} of 3`;
    document.getElementById('questionCategory').textContent = q.category;
    document.getElementById('questionText').textContent = q.text;

    const container = document.getElementById('optionsContainer');
    container.innerHTML = '';
    q.options.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'option' + (answers[currentQ] === opt.cluster ? ' selected' : '');
      btn.innerHTML = `
        <span class="option-letter">${opt.letter}</span>
        <div class="option-body">
          <div class="option-title">${opt.title}</div>
          <div class="option-sub">${opt.sub}</div>
        </div>
      `;
      btn.addEventListener('click', () => selectAnswer(opt.cluster, btn));
      container.appendChild(btn);
    });

    document.getElementById('prevBtn').disabled = currentQ === 0;
    document.getElementById('nextBtn').disabled = answers[currentQ] === undefined;
    document.getElementById('nextBtn').textContent = currentQ === 2 ? 'View Results →' : 'Next →';
  }

  function selectAnswer(cluster, el) {
    answers[currentQ] = cluster;
    document.querySelectorAll('.option').forEach(o => o.classList.remove('selected'));
    el.classList.add('selected');
    document.getElementById('nextBtn').disabled = false;
  }

  function nextQuestion() {
    if (currentQ < 2) { currentQ++; renderQuestion(); }
    else { showResults(); }
  }

  function prevQuestion() {
    if (currentQ > 0) { currentQ--; renderQuestion(); }
  }

  function showResults() {
    const counts = { early: 0, mid: 0, late: 0 };
    answers.forEach(a => { if (a) counts[a]++; });
    const cluster = Object.entries(counts).sort((a, b) => b[1] - a[1])[0][0];
    const r = currentBlock.results[cluster];

    document.getElementById('clusterName').textContent = r.name;
    document.getElementById('mirrorText').textContent = r.mirror;
    document.getElementById('leverText').textContent = r.lever;
    document.getElementById('progressFill').style.width = '100%';
    document.getElementById('progressText').textContent = 'Complete';
    document.getElementById('questionView').style.display = 'none';
    document.getElementById('resultsView').style.display = 'block';
    document.getElementById('modal').scrollTop = 0;

    completedBlocks.add(currentBlock.id);
    renderGrid();
  }

  function init() {
    renderGrid();

    document.getElementById('modalOverlay').addEventListener('click', (e) => {
      if (e.target === document.getElementById('modalOverlay')) closeModal();
    });
    document.getElementById('modalClose').addEventListener('click', closeModal);
    document.getElementById('prevBtn').addEventListener('click', prevQuestion);
    document.getElementById('nextBtn').addEventListener('click', nextQuestion);
    document.getElementById('restartBtn').addEventListener('click', () => {
      resetState();
      renderQuestion();
      document.getElementById('modal').scrollTop = 0;
    });

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>