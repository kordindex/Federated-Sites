---
import Layout from '~/layouts/PageLayout.astro';
import dmcLogo from '~/assets/images/dmclogo.png';

const metadata = {
  title: 'Leadership Coherence Diagnostic — Denver Mattress Co.',
  description: 'A structural diagnostic that identifies how pressure moves through your leadership system.',
};
---

<Layout metadata={metadata}>

<div class="diagnostic-shell" id="diagnostic-shell">

  <!-- ── ORIENT ──────────────────────────────────────────────────────── -->
  <div class="screen" id="screen-orient">
    <div class="orient-inner">
      <div class="dmc-logo-wrap">
        <img src={dmcLogo.src} alt="Denver Mattress Co." class="dmc-logo-img orient-logo">
      </div>
      <h1 class="orient-title">Leadership<br>Diagnostic</h1>
      <div class="orient-divider"></div>
      <p class="orient-body">This diagnostic reads how pressure is currently moving through your leadership system at Denver Mattress Company.</p>
      <p class="orient-body">You'll respond to 20 questions. Each describes a recognizable organizational situation. Select the response that most closely matches how things actually work right now, not how you'd like them to work.</p>
      <p class="orient-body">There are no right or wrong answers. The diagnostic identifies structural patterns, not individual performance. Your honest responses produce the most useful results.</p>
      <p class="orient-body orient-note">Allow about 15 minutes of uninterrupted time. When you're ready, begin.</p>
      <div class="orient-what-label">About Your Facilitator</div>
      <p class="orient-body">Christine Kahane is a leadership strategist and organizational systems designer with twenty years of experience working inside complex, high-pressure organizations. She is the founder of The Coherence Company and the Institute for UNLearning, and the author of <em>UNLEARNING: Leading Change Without Resistance</em>. Her work has a specific history with Denver Mattress: she previously designed and facilitated a year-long bilingual leadership development program for DMC's plant foremen and line supervisors. This diagnostic is built on that same foundation.</p>
      <div class="orient-access-group">
        <label class="field-label" for="access-code">Access Code</label>
        <input class="field-input" type="text" id="access-code" placeholder="Enter your access code" autocomplete="off" spellcheck="false">
        <p class="access-error screen--hidden" id="access-error">Invalid access code. Please check your invitation email.</p>
      </div>
      <button class="btn-primary" id="btn-begin">Begin Diagnostic</button>
    </div>
  </div>

  <!-- ── QUESTION ────────────────────────────────────────────────────── -->
  <div class="screen screen--hidden" id="screen-question">
    <div class="q-masthead">
      <img src={dmcLogo.src} alt="Denver Mattress Co." class="dmc-logo-img q-masthead-logo">
      <div class="q-progress-bar"><div class="q-progress-fill" id="q-progress-fill"></div></div>
    </div>
    <div class="q-body">
      <p class="q-text" id="q-text"></p>
      <div class="q-answers" id="q-answers"></div>
    </div>
    <div class="q-nav">
      <button class="btn-ghost" id="btn-prev">← Previous</button>
      <button class="btn-primary btn--disabled" id="btn-next">Next →</button>
    </div>
  </div>

  <!-- ── CAPTURE ─────────────────────────────────────────────────────── -->
  <div class="screen screen--hidden" id="screen-capture">
    <div class="capture-inner">
      <span class="eyebrow">Almost there</span>
      <h2 class="capture-title">Ready to view<br>your results.</h2>
      <p class="capture-body">Enter your information to view your results. All fields are required.</p>
      <div class="capture-form">
        <div class="field-group">
          <label class="field-label" for="user-name">Full Name</label>
          <input class="field-input" type="text" id="user-name" placeholder="Full name" autocomplete="name">
        </div>
        <div class="field-group">
          <label class="field-label" for="user-email">Work Email</label>
          <input class="field-input" type="email" id="user-email" placeholder="you@denvermatco.com" autocomplete="email">
        </div>
        <div class="field-group">
          <label class="field-label" for="user-role">Role / Title</label>
          <input class="field-input" type="text" id="user-role" placeholder="Your current role">
        </div>
        <div class="field-group">
          <label class="field-label" for="user-years">Years at Denver Mattress</label>
          <input class="field-input" type="number" id="user-years" placeholder="0" min="0">
        </div>
        <button class="btn-primary btn-generate" id="btn-generate">View My Results</button>
      </div>
    </div>
  </div>

  <!-- ── RESULTS ─────────────────────────────────────────────────────── -->
  <div class="screen screen--hidden" id="screen-results">
    <div class="results-wrap">

      <div class="results-notice">
        Your results are available on this page only. They will not be saved or sent to you automatically. Take a moment to review before closing.
      </div>

      <h1 class="results-page-title">Your Leadership Diagnostic Results</h1>

      <div class="results-masthead">
        <img src={dmcLogo.src} alt="Denver Mattress Co." class="dmc-logo-img results-logo">
        <div class="results-masthead-right">
          <span id="res-prepared-for" class="results-prepared"></span>
          <span id="res-date" class="results-date"></span>
        </div>
      </div>

      <div class="results-meta-grid">
        <div class="results-meta-cell">
          <span class="results-meta-label">Primary Pattern</span>
          <span id="res-pattern-meta" class="results-meta-value"></span>
        </div>
        <div class="results-meta-cell">
          <span class="results-meta-label">Pressure Level</span>
          <span id="res-pressure-meta" class="results-meta-value"></span>
        </div>
        <div class="results-meta-cell">
          <span class="results-meta-label">Report ID</span>
          <span id="res-report-id" class="results-meta-value results-meta-mono"></span>
        </div>
      </div>

      <!-- Section I: Pattern Recognition -->
      <div class="results-section">
        <div class="results-section-eyebrow">Section I: Structural Pattern Recognition</div>
        <h2 class="results-h2">Your Primary Structural Pattern</h2>

        <div class="pattern-block">
          <div class="pattern-eyebrow">Primary Structural Pattern Detected</div>
          <div class="pattern-name" id="res-pattern-name"></div>
          <p class="pattern-identifier" id="res-pattern-identifier"></p>
        </div>

        <h3 class="results-h3">Supporting Symptoms</h3>
        <ul class="symptom-list" id="res-symptoms"></ul>
      </div>

      <!-- Section II: Pattern Explanation -->
      <div class="results-section">
        <div class="results-section-eyebrow">Section II: Pattern Explanation</div>
        <h2 class="results-h2">How This Pattern Forms</h2>
        <p class="results-body" id="res-how-it-forms"></p>

        <h3 class="results-h3">How Pressure Amplifies the Pattern</h3>
        <p class="results-body" id="res-pressure-text"></p>
      </div>

      <!-- Section III: System Behavior -->
      <div class="results-section">
        <div class="results-section-eyebrow">Section III: System Behavior</div>
        <h2 class="results-h2">How the Pattern Shows Up</h2>
        <p class="results-intro-note">Leaders often sense when something in the system is misaligned before they can fully articulate the cause. The scenarios below illustrate how the pattern identified in your diagnostic typically appears in everyday leadership interactions, decisions, and communication flows.</p>
        <div id="res-scenes"></div>
      </div>

      <!-- Section IV: Recalibration -->
      <div class="results-section">
        <div class="results-section-eyebrow">Section IV: Leadership Recalibration</div>
        <h2 class="results-h2">Where to Focus Next</h2>

        <h3 class="results-h3">Where Leadership Attention Matters Most</h3>
        <p class="results-body" id="res-recalibration"></p>

        <h3 class="results-h3">The First Recalibration Move</h3>
        <p class="results-body" id="res-first-move"></p>
      </div>

      <!-- Next Steps -->
      <div class="results-section">
        <div class="results-section-eyebrow">Next Steps</div>
        <h2 class="results-h2">What Happens Next</h2>
        <p class="results-body">A member of the Coherence Co. team will be in touch to schedule a debrief conversation, typically 45 to 60 minutes, to walk through what your results mean in the context of your role and your department. Your results are confidential and will not be shared with other participants or with Denver Mattress leadership without your knowledge.</p>
      </div>

      <div class="results-actions">
        <button class="btn-primary" onclick="window.print()">Print Results</button>
        <button class="btn-ghost" id="btn-restart">← Take Again</button>
      </div>

    </div>
  </div>

</div>

<script is:inline>
  // ── Report Content Library ────────────────────────────────────────
  var REPORT_CONTENT = {
    'Velocity Strain': {
      pattern_identifier: 'Your leadership system is operating faster than it can reliably integrate change.',
      symptoms: [
        'Decisions are made quickly but require frequent course correction',
        'Important information arrives late or partially filtered',
        'Teams feel pressure to respond before interpretation stabilizes'
      ],
      how_it_forms: 'Velocity Strain appears when the pace of decisions and initiatives begins to exceed the organization\'s ability to integrate change. Speed itself is not the issue. Many organizations operate successfully at high velocity. Strain emerges when decisions accelerate faster than shared understanding and integration capacity can keep up. When this occurs, leaders often experience strong momentum alongside increasing coordination effort. Teams continue executing, but the narrative behind priorities becomes harder to sustain across the organization.',
      scenes: [
        {
          title: 'Scene 1: The Initiative That Never Fully Lands',
          body: 'A new strategic priority is introduced with clarity and momentum. Leaders align in the room. Within two weeks, a second initiative follows, equally urgent, equally clear. Teams begin absorbing both simultaneously. The first initiative continues moving forward, but the integration work it required is quietly set aside. Over time, execution remains active while the understanding behind it becomes uneven across the organization.'
        },
        {
          title: 'Scene 2: The Decision That Moves Too Quickly',
          body: 'A leadership meeting surfaces an emerging challenge. Before the implications are fully examined, a decision is reached. The pace of the meeting, the pressure of competing priorities, and the discomfort of sustained uncertainty all push the conversation toward resolution. The decision is sound on its surface. But three weeks later, leaders discover that different teams have interpreted it differently. Clarification cycles begin.'
        },
        {
          title: 'Scene 3: The Coordination Cost No One Tracks',
          body: 'Performance indicators remain strong. Output continues. But leaders begin noticing that an increasing share of their time is spent in alignment conversations, clarifying direction, resolving interpretive differences, reconnecting execution to intent. The work itself has not changed. The effort required to keep it coherent has.'
        }
      ],
      recalibration_focus: 'Organizations experiencing Velocity Strain often regain coherence by recalibrating the relationship between pace and integration. Leaders frequently begin by resequencing active initiatives so teams can fully integrate direction already introduced into the system. This allows clarity and coordination to stabilize without sacrificing momentum. When pace and integration move together again, alignment becomes easier to maintain.',
      first_move: 'Map active strategic initiatives currently inside the system. Identify where concurrency is highest, where teams are absorbing the most simultaneous direction. For 30 days, introduce a simple sequencing discipline: no new strategic thread enters the system until one existing thread has fully landed. This is not a slowdown. It is a recalibration of the relationship between velocity and integration, the structural condition most directly driving the pattern identified in your diagnostic.',
      pressure: {
        'Early Signals': 'Your responses indicate that pressure signals are beginning to appear at the edges of the leadership system. Organizations at this stage often continue executing effectively, but early markers of velocity strain are present. The window to recalibrate is open, and widest now, before strain compounds.',
        'Structural Pressure': 'Your responses indicate that pressure signals may be appearing across multiple areas of the leadership system. Organizations at this stage often continue executing effectively, but maintaining alignment requires increasing effort. Leaders may notice more clarification cycles, more coordination work, and greater attention required to keep priorities moving in the same direction.',
        'Systemic Strain': 'Your responses indicate significant pressure across the leadership system. Organizations at this stage often experience execution continuing alongside visible coordination difficulty. Alignment conversations are consuming increasing leadership bandwidth, and the effort required to sustain coherence is becoming structural rather than situational.'
      }
    },
    'Interpretation Drift': {
      pattern_identifier: 'Your leadership system is generating inconsistent interpretations of shared information.',
      symptoms: [
        'Leaders describe the same situation in noticeably different ways',
        'Teams receive mixed signals when direction changes',
        'Assumptions that seemed shared surface as divergent during execution'
      ],
      how_it_forms: 'Interpretation Drift appears when leaders consistently move from information to action without first verifying that their interpretations of that information are shared. In fast-moving environments, this gap is easy to miss. Leaders align on outcomes while holding different assumptions about what those outcomes require. Over time, execution diverges not because of disagreement, but because the shared understanding was never fully established.',
      scenes: [
        {
          title: 'Scene 1: The Meeting That Ended in Agreement',
          body: 'A leadership discussion reaches apparent consensus. Everyone in the room nods. A decision is made. Over the following week, each leader communicates the decision to their teams, and each communication carries a slightly different emphasis. By the time the decision reaches execution, three versions of it are in motion. No one intended this. The drift began the moment the room moved to resolution before ensuring the interpretation was shared.'
        },
        {
          title: 'Scene 2: The Priority That Landed Differently',
          body: 'A strategic shift is announced with clarity and urgency. Leaders leave the meeting aligned on the what. They carry different assumptions about the why, and about what it means for existing work. Two weeks later, some teams have resequenced their priorities. Others have added the new priority alongside existing work. The difference traces back to a moment of assumed alignment that was never verified.'
        },
        {
          title: 'Scene 3: The Assumption No One Named',
          body: 'A significant decision is made. It rests on several assumptions: about the market, about team capacity, about timeline. None of these assumptions are articulated during the decision conversation. They are held individually, felt as obvious, and never surfaced. When execution reveals the assumptions were different across the leadership team, the conversation that should have happened before the decision begins happening after it.'
        }
      ],
      recalibration_focus: 'Organizations experiencing Interpretation Drift often recalibrate by introducing explicit assumption alignment before major decisions move to execution. This does not require lengthy process. It requires a brief, deliberate pause before commitment to surface what each leader believes the decision means, what assumptions underpin it, and what it requires from the organization. When interpretations are verified rather than assumed, alignment becomes durable rather than provisional.',
      first_move: 'Before the next significant decision your leadership team makes, introduce a single alignment question: "What does each of us believe this decision requires from the organization in the next 30 days?" Record the answers. Where they differ, clarify before proceeding. This is not additional process. It is the minimum structural step that converts assumed alignment into verified alignment. Do this consistently for 30 days and measure how often clarification cycles downstream diminish.',
      pressure: {
        'Early Signals': 'Your responses indicate early markers of interpretation drift inside the leadership system. The pattern is not yet compounding, but the conditions for drift are present. The most effective intervention happens before assumptions accumulate, when the cost of alignment is still low.',
        'Structural Pressure': 'Your responses indicate that interpretation gaps are beginning to affect execution across the organization. Teams are likely experiencing mixed signals, and leaders may be investing increasing effort in clarification conversations that could have been prevented upstream.',
        'Systemic Strain': 'Your responses indicate significant interpretation divergence across the leadership system. Teams are likely operating from meaningfully different understandings of strategic direction, and the organizational effort required to maintain coordination is increasing. Recalibration at this stage requires deliberate structural intervention, not incremental adjustment.'
      }
    },
    'Signal Suppression': {
      pattern_identifier: 'Your leadership system is not surfacing the information it needs to navigate pressure effectively.',
      symptoms: [
        'Concerns surface after the fact rather than while there is still time to act',
        'Leadership discussions converge quickly without substantive disagreement',
        'Teams continue executing even when they hold reservations about direction'
      ],
      how_it_forms: 'Signal Suppression appears when the organizational conditions for candor begin to erode. This rarely happens through explicit instruction. It happens through accumulated signals: the concern that was raised and set aside, the meeting that moved quickly past disagreement, the leader whose pushback was received as obstruction. Over time, teams learn to calibrate what is safe to surface. Information begins arriving at leadership filtered, delayed, or absent.',
      scenes: [
        {
          title: 'Scene 1: The Concern That Stayed Private',
          body: 'A team member identifies a meaningful risk in an active initiative. They consider raising it. They read the urgency in the room: the pressure to execute, the investment already made, the implicit signal that the direction is set. The concern is not raised in the meeting. It surfaces in a private conversation afterward, or in a retrospective weeks later, after the risk has materialized. The information existed. It did not reach the leaders who needed it.'
        },
        {
          title: 'Scene 2: The Meeting That Moved Too Smoothly',
          body: 'A leadership discussion produces rapid consensus. No significant objections are raised. The decision is made efficiently. Later, several participants acknowledge privately that they held reservations they chose not to voice. The meeting felt productive. The decision moved forward missing information that was present in the room but never surfaced. The cost of that silence appears in execution.'
        },
        {
          title: 'Scene 3: The Signal That Arrived Too Late',
          body: 'An emerging execution problem becomes visible to frontline teams before it appears in leadership metrics. Teams observe the early signs. They wait to see if the situation resolves. When it does not, the signal begins moving upward, slowly, carefully, with increasing qualification. By the time it reaches leadership, the window for low-cost intervention has passed. The delay was not intentional. It was structural.'
        }
      ],
      recalibration_focus: 'Organizations experiencing Signal Suppression often recalibrate by deliberately redesigning the conditions under which concerns surface, not by asking people to speak more freely, but by creating structured moments where dissent and concern are formally invited before decisions close. When the organizational signal is that candor is welcomed and acted upon, information begins moving more reliably through the system.',
      first_move: 'In your next three leadership meetings, introduce a structured dissent moment before any significant decision closes: "Before we move forward, I want to hear specifically what concerns or reservations anyone holds about this direction." Record what surfaces. Act on at least one concern visibly. Repeat. The goal is not to slow decisions. It is to demonstrate that candor has a reliable pathway and a visible consequence. When that signal is established, information quality improves upstream.',
      pressure: {
        'Early Signals': 'Your responses indicate early signs of signal suppression in the leadership system. The pattern is not yet entrenched, but the conditions for information filtering are present. The most effective intervention happens early, before teams have fully calibrated what is safe to surface.',
        'Structural Pressure': 'Your responses indicate that signal flow is being affected across the organization. Leaders are likely receiving information that has been partially filtered before it reaches them. The gap between what teams observe and what leadership hears may be widening in ways that are not yet fully visible.',
        'Systemic Strain': 'Your responses indicate significant signal suppression across the leadership system. Information is likely reaching leadership delayed, filtered, or absent. Teams have calibrated their communication to the perceived preferences and pressures of the environment. Recalibration requires deliberate and sustained structural change. Signals about candor must be sent consistently and visibly over time.'
      }
    }
  };

  // ── Questions ─────────────────────────────────────────────────────
  var QUESTIONS = [
    { id:1,  cluster:'Interpretation Drift', text:'When conditions shift quickly, how consistent are leaders\' descriptions and explanations of what is happening and what it means for teams?', answers:['Leaders describe the situation differently, and alignment takes time','Leaders align eventually, but mixed signals appear in the meantime','Leaders generally describe the situation in similar ways','Leaders pause briefly to align interpretation before acting'] },
    { id:2,  cluster:'Interpretation Drift', text:'When priorities shift, how clearly is the reasoning behind the change communicated among leaders?', answers:['Different leaders explain the shift in noticeably different ways','The explanation becomes clearer over time, but early communication varies','Leaders generally communicate a shared explanation early','Leaders align the rationale together before communicating the change'] },
    { id:3,  cluster:'Interpretation Drift', text:'In leadership discussions, how often do leaders discover they are working from different assumptions?', answers:['Frequently: differences surface late in the discussion process which slows alignment','Occasionally: differences emerge during discussion and require clarification','Rarely: assumptions are mostly shared from the outset of discussion','Leaders intentionally surface assumptions early in the discussion before decisions are made'] },
    { id:4,  cluster:'Interpretation Drift', text:'After major decisions are made, how consistently do teams take action from the same understanding?', answers:['Teams move forward, but in noticeably different directions','Alignment improves gradually as teams gain clarification','Most teams act from a shared understanding','Teams begin with a clear and consistent understanding'] },
    { id:5,  cluster:'Interpretation Drift', text:'When new external pressures appear (market shifts, regulation, technology), how quickly do leaders reach a shared understanding of implications and impact?', answers:['Leaders interpret the implications differently','Shared understanding forms only after extended discussion','Shared understanding usually forms fairly quickly','Leaders intentionally align on implications before action begins'] },
    { id:6,  cluster:'Interpretation Drift', text:'How often do leadership conversations end with surface agreement while ambiguity remains unresolved?', answers:['Often','Sometimes','Rarely','Leaders usually resolve ambiguity before coming to agreement'] },
    { id:7,  cluster:'Interpretation Drift', text:'When leaders communicate direction to the organization, how consistent are the messages people receive?', answers:['Messages vary noticeably across leaders','Messages are broadly similar, but emphasis differs','Messages are mostly consistent among leadership','Leaders intentionally coordinate messaging before it is communicated'] },
    { id:8,  cluster:'Velocity Strain', text:'When new initiatives are introduced, what usually happens to existing priorities?', answers:['Most existing work continues alongside the new initiative','Some priorities shift, but many remain active','Work is selectively resequenced to maintain focus','Leaders pause to reassess priorities before introducing new work'] },
    { id:9,  cluster:'Velocity Strain', text:'How often are teams asked to absorb new direction while still executing earlier initiatives?', answers:['Frequently: multiple priorities overlap at once','Sometimes: new work arrives before earlier work is fully integrated','Rarely: priorities are usually sequenced with care','Leaders actively manage how much change enters the system at one time'] },
    { id:10, cluster:'Velocity Strain', text:'How is the pace of change usually handled in your organization?', answers:['Speed is assumed and momentum is prioritized','Pace is discussed, but difficult to regulate in practice','Pace is monitored and occasionally adjusted','Pace is actively regulated relative to system capacity'] },
    { id:11, cluster:'Velocity Strain', text:'When leadership decisions are made, how consistently do teams move in the same direction afterward?', answers:['Teams often move in different directions before alignment stabilizes','Teams usually move in the same direction but require clarification','Teams generally move in the same direction with minimal clarification','Teams move in the same direction with clear shared understanding'] },
    { id:12, cluster:'Velocity Strain', text:'How often does the organization introduce new work to address issues created by earlier changes?', answers:['Often: new initiatives are layered onto unresolved ones','Sometimes: additional work appears before earlier change settles','Rarely: earlier initiatives are usually stabilized first','Leaders typically stabilize earlier change before adding more'] },
    { id:13, cluster:'Velocity Strain', text:'When priorities change, how much time do people usually have to absorb the new direction?', answers:['Very little: expectations shift immediately','Some time is available, but not always enough for full integration','Teams usually have sufficient time to absorb the change','Leaders intentionally create time for integration before expecting full execution'] },
    { id:14, cluster:'Velocity Strain', text:'How often does leadership revisit earlier initiatives to see how effectively they have been integrated into ongoing work?', answers:["Rarely: attention moves quickly to what's next","Sometimes: integration is checked later, if issues appear","Often: leaders review whether change has truly landed","Integration checks are built into how initiatives are sequenced"] },
    { id:15, cluster:'Signal Suppression', text:'In leadership meetings, how often does substantive disagreement surface before decisions are finalized?', answers:['Rarely: discussions converge quickly','Sometimes: disagreement appears, but cautiously','Frequently: disagreement helps clarify decisions','Leaders actively invite substantive differences in view before coming to agreement'] },
    { id:16, cluster:'Signal Suppression', text:'How do concerns about emerging issues usually surface in your organization?', answers:['Mostly in private conversations or after the fact','Cautiously, once concern is harder to ignore','Openly, while there is still time to respond','Leaders actively create conditions for concerns to surface early'] },
    { id:17, cluster:'Signal Suppression', text:'When issues begin emerging in execution, how early do they usually become visible to leadership?', answers:['Late: issues often appear suddenly','Only after results begin to shift, either positively or negatively','Early signals usually appear before formal indicators change','Leaders intentionally look for early signs before formal indicators move'] },
    { id:18, cluster:'Signal Suppression', text:'How often do teams continue executing even when concerns about the direction of work or priorities surface?', answers:['Often: execution continues while concerns stay mostly unspoken','Sometimes: concerns are present but only partly voiced','Rarely: concerns are usually surfaced early','Teams are expected to raise concerns as soon as they appear'] },
    { id:19, cluster:'Signal Suppression', text:'When pressure is building in the organization, when do its effects usually become visible to leadership?', answers:['Only after execution begins to break down','When teams begin signaling coordination difficulties','When leaders begin discussing emerging concerns','Early, through questions, disagreement, and operational signals'] },
    { id:20, cluster:'Signal Suppression', text:'When issues involve risk, tension, or competing priorities, how is candor usually handled?', answers:['Harmony or the appearance of harmony is usually protected over challenge to the status quo','Challenge appears, but cautiously','Honest disagreement is generally acceptable','Leaders actively make space for candid discussion'] },
  ];

  var LABELS = ['A','B','C','D'];
  var TOTAL  = QUESTIONS.length;

  var current = 0;
  var answers = new Array(TOTAL).fill(null);

  var screenOrient  = document.getElementById('screen-orient');
  var screenQ       = document.getElementById('screen-question');
  var screenCap     = document.getElementById('screen-capture');
  var screenResults = document.getElementById('screen-results');
  var qText         = document.getElementById('q-text');
  var qAnswers      = document.getElementById('q-answers');
  var btnPrev       = document.getElementById('btn-prev');
  var btnNext       = document.getElementById('btn-next');
  var btnBegin      = document.getElementById('btn-begin');
  var btnGenerate   = document.getElementById('btn-generate');
  var btnRestart    = document.getElementById('btn-restart');

  function showScreen(screen) {
    [screenOrient, screenQ, screenCap, screenResults].forEach(function(s) {
      s.classList.add('screen--hidden');
    });
    screen.classList.remove('screen--hidden');
    window.scrollTo(0, 0);
  }

  btnBegin.addEventListener('click', function() {
    var code = document.getElementById('access-code').value.trim().toUpperCase();
    var errorEl = document.getElementById('access-error');
    if (code !== 'DENVER') {
      errorEl.classList.remove('screen--hidden');
      return;
    }
    errorEl.classList.add('screen--hidden');
    showScreen(screenQ);
    renderQuestion(0);
  });

  btnPrev.addEventListener('click', function() {
    if (current > 0) { current--; renderQuestion(current); }
  });

  btnNext.addEventListener('click', function() {
    if (answers[current] === null) return;
    if (current < TOTAL - 1) { current++; renderQuestion(current); }
    else { showScreen(screenCap); }
  });

  btnGenerate.addEventListener('click', function() {
    var name  = document.getElementById('user-name').value.trim();
    var email = document.getElementById('user-email').value.trim();
    var role  = document.getElementById('user-role').value.trim();
    var years = document.getElementById('user-years').value.trim();
    if (!name || !email || !role || years === '') {
      alert('Please complete all four fields before continuing.');
      return;
    }
    generateReport(name, email, role, years);
  });

  btnRestart.addEventListener('click', function() {
    current = 0;
    answers = new Array(TOTAL).fill(null);
    document.getElementById('user-name').value  = '';
    document.getElementById('user-email').value = '';
    document.getElementById('user-role').value  = '';
    document.getElementById('user-years').value = '';
    showScreen(screenOrient);
  });

  function renderQuestion(idx) {
    var q = QUESTIONS[idx];
    qText.innerHTML = q.text + '<span class="q-inline-counter"> (Question ' + (idx + 1) + ' of ' + TOTAL + ')</span>';
    qAnswers.innerHTML = '';
    q.answers.forEach(function(ansText, i) {
      var btn = document.createElement('button');
      btn.className = 'answer-btn' + (answers[idx] === i ? ' answer-btn--selected' : '');
      btn.innerHTML = '<span class="answer-label">' + LABELS[i] + '</span><span class="answer-text">' + ansText + '</span>';
      btn.addEventListener('click', function() { answers[idx] = i; renderQuestion(idx); });
      qAnswers.appendChild(btn);
    });
    btnPrev.style.visibility = idx === 0 ? 'hidden' : 'visible';
    btnNext.classList.toggle('btn--disabled', answers[idx] === null);
    btnNext.textContent = idx === TOTAL - 1 ? 'Continue →' : 'Next →';
    var fill = document.getElementById('q-progress-fill');
    if (fill) fill.style.width = Math.round(((idx + 1) / TOTAL) * 100) + '%';
  }

  // ── Scoring ───────────────────────────────────────────────────────
  var SCORE_MAP = { A: 2, B: 1, C: 0, D: -1 };
  var CLUSTERS = {
    'Interpretation Drift': { start: 0, end: 6 },
    'Velocity Strain':      { start: 7, end: 13 },
    'Signal Suppression':   { start: 14, end: 19 },
  };
  var PRESSURE_LEVELS = [
    { label: 'Systemic Strain',     min: 13 },
    { label: 'Structural Pressure', min: 7  },
    { label: 'Early Signals',       min: 0  },
  ];
  var TIE_PRIORITY = ['Velocity Strain', 'Interpretation Drift', 'Signal Suppression'];

  function generateReportId(primary) {
    var prefix = { 'Interpretation Drift': 'ID', 'Velocity Strain': 'VS', 'Signal Suppression': 'SS' }[primary] || 'CD';
    return 'DMC-' + prefix + '-' + Date.now().toString(36).toUpperCase();
  }

  function scoreAnswers(answerArray, name, email, role, years) {
    var scored = answerArray.map(function(a) { return SCORE_MAP[a]; });
    var patternScores = {};
    Object.keys(CLUSTERS).forEach(function(pattern) {
      var c = CLUSTERS[pattern];
      var total = 0;
      for (var i = c.start; i <= c.end; i++) { total += scored[i]; }
      patternScores[pattern] = total;
    });
    var sortedPatterns = Object.keys(patternScores).sort(function(a, b) {
      if (patternScores[b] !== patternScores[a]) return patternScores[b] - patternScores[a];
      return TIE_PRIORITY.indexOf(a) - TIE_PRIORITY.indexOf(b);
    });
    var positiveTotal = scored.reduce(function(s, v) { return s + (v > 0 ? v : 0); }, 0);
    var pressureLevel = PRESSURE_LEVELS.find(function(p) { return positiveTotal >= p.min; }).label;
    var dCount = answerArray.filter(function(a) { return a === 'D'; }).length;
    return {
      report_id:    generateReportId(sortedPatterns[0]),
      participant:  { name: name, email: email, role: role, years: years },
      patterns: {
        primary:   sortedPatterns[0],
        secondary: sortedPatterns[1],
        scores:    patternScores,
      },
      pressure:     { level: pressureLevel },
      validity:     { d_count: dCount, likely_gamed: dCount >= 14 },
      raw_answers:  answerArray,
      date_display: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
    };
  }

  // ── Render results on screen ──────────────────────────────────────
  function displayResults(result) {
    var primary      = result.patterns.primary;
    var pressure     = result.pressure.level;
    var content      = REPORT_CONTENT[primary];
    var pressureText = content.pressure[pressure];

    document.getElementById('res-prepared-for').textContent = 'Prepared for ' + result.participant.name;
    document.getElementById('res-date').textContent = result.date_display;
    document.getElementById('res-report-id').textContent = result.report_id;
    document.getElementById('res-pattern-meta').textContent = primary;
    document.getElementById('res-pressure-meta').textContent = pressure;

    document.getElementById('res-pattern-name').textContent = primary;
    document.getElementById('res-pattern-identifier').textContent = content.pattern_identifier;

    var symptomsList = document.getElementById('res-symptoms');
    symptomsList.innerHTML = '';
    content.symptoms.forEach(function(s) {
      var li = document.createElement('li');
      li.className = 'symptom-item';
      li.innerHTML = '<span class="symptom-dash">—</span><span>' + s + '</span>';
      symptomsList.appendChild(li);
    });

    document.getElementById('res-how-it-forms').textContent = content.how_it_forms;
    document.getElementById('res-pressure-text').textContent = pressureText;

    var scenesEl = document.getElementById('res-scenes');
    scenesEl.innerHTML = '';
    content.scenes.forEach(function(scene) {
      var div = document.createElement('div');
      div.className = 'scene-block';
      div.innerHTML = '<div class="scene-title">' + scene.title + '</div><p class="scene-body">' + scene.body + '</p>';
      scenesEl.appendChild(div);
    });

    document.getElementById('res-recalibration').textContent = content.recalibration_focus;
    document.getElementById('res-first-move').textContent = content.first_move;

    showScreen(screenResults);
  }

  var SHEETS_URL = 'https://script.google.com/macros/s/AKfycbym-UpGG7a9QEs9z4juRe-fSukKwSdsto48a4-hAk7vQ5IV1eRnf3kYtUTwY3ENfbc8aw/exec';

  function generateReport(name, email, role, years) {
    btnGenerate.textContent = 'Loading...';
    btnGenerate.disabled = true;
    try {
      var answerLetters = answers.map(function(i) { return ['A','B','C','D'][i]; });
      var result = scoreAnswers(answerLetters, name, email, role, years);

      // Fire-and-forget POST to Google Sheets logger
      fetch(SHEETS_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain' },
        body: JSON.stringify({
          name:              result.participant.name,
          email:             result.participant.email,
          role:              result.participant.role,
          years:             result.participant.years,
          primary_pattern:   result.patterns.primary,
          secondary_pattern: result.patterns.secondary,
          pressure_level:    result.pressure.level,
          report_id:         result.report_id,
          date:              result.date_display,
          likely_gamed:      result.validity.likely_gamed ? 'YES' : 'No',
          raw_answers:       result.raw_answers,
        }),
      }).catch(function() {});

      displayResults(result);
    } catch (err) {
      alert('Something went wrong. Please try again.');
      console.error(err);
      btnGenerate.textContent = 'View My Results';
      btnGenerate.disabled = false;
    }
  }
</script>

</Layout>

