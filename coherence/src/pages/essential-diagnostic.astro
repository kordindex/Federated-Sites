      var f2 = 'Coherence Company  -  System Alignment Advisory';
      var f3 = 'coherencecompany.com  -  info@coherencecompany.com';
      doc.text(f1, PW / 2 - doc.getTextWidth(f1) / 2, BOTTOM + 12);
      doc.text(f2, PW / 2 - doc.getTextWidth(f2) / 2, BOTTOM + 22);
      doc.text(f3, PW / 2 - doc.getTextWidth(f3) / 2, BOTTOM + 32);
    }

    // ════════════════════════════════════════════
    // PAGE 1 — STRUCTURAL PATTERN RECOGNITION
    // ════════════════════════════════════════════
    pageHeader();
    pageFooter();

    var y = TOP;

    // Section tag
    setFont(7, 'bold', SLATE_LIGHT);
