    y += blockH + 14;

    // Symptoms
    setFont(10, 'bold', NAVY);
    doc.text('Supporting Symptoms', ML, y);
    y += 14; // FIX 6: was y += 4 — too tight; bump to 14 for visual breathing room
    setFont(10, 'normal', SLATE);
