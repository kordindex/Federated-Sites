    y = text('Your responses were analyzed across three system forces: Interpretation Drift, Velocity Strain, and Signal Suppression. From these signals, the diagnostic identifies the dominant structural pattern currently shaping your leadership environment.', ML, y, { lineHeight: 1.75 });
    y += 12;

    // FIX 5: Pattern block — measure actual content height before drawing box
    setFont(7, 'bold', GOLD);
