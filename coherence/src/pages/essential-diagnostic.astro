    y += 10;

    setFont(10, 'normal', SLATE);
    y = text('This diagnostic analyzes the structural signals inside your leadership environment and identifies the pattern most likely shaping decision flow, communication, and organizational response.', ML, y, { lineHeight: 1.75 });
    y += 10;

    y = text('The report is organized using the same sequence through which executives typically process insight and act on it:', ML, y, { lineHeight: 1.75 });
    y += 8;

    // FIX 2: Replace Unicode arrows (U+2192) with ASCII " > "
    setFont(10, 'italic', NAVY);
    y = text('Recognition  >  Explanation  >  Behavior  >  Recalibration', ML, y);
