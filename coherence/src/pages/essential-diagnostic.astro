    y += 22;
    doc.text('System Diagnostic Report', ML, y);
    y += 20;

    // FIX 4: Meta row — compute column positions dynamically to prevent overflow
    // Measure each label so we can space columns safely within CW
    var metaLabels = ['DIAGNOSTIC COMPLETED', 'PRIMARY STRUCTURAL PATTERN', 'PRESSURE LEVEL'];
    var metaValues = [date, primary, pressure];
    setFont(7, 'bold', SLATE_LIGHT);
    // Reserve the last column at 2/3 of CW; space first two evenly in first 2/3
    var col0 = ML;
    var col1 = ML + Math.round(CW * 0.30);
    var col2 = ML + Math.round(CW * 0.65);

    var metaY = y;
    doc.text(metaLabels[0], col0, metaY);
