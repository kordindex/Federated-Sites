    y = text('Clarity is the first step toward alignment. When leaders can see how their system behaves under pressure, they gain the ability to recalibrate it.', ML, y, { lineHeight: 1.8 });
    y += 10;
    y = text('Organizations that choose to continue the analysis often schedule a Leadership Coherence Debrief, where the diagnostic findings are reviewed in detail and translated into practical leadership adjustments.', ML, y, { lineHeight: 1.8 });
    y += 14;

    // FIX 8: CTA block — measure actual body text height before drawing the box
    setFont(9, 'normal', SLATE);
    var ctaBodyText = 'You may schedule a 1:1 Leadership Coherence Debrief with Christine to walk through the diagnostic findings, interpret the structural signals inside your organization, and identify potential next steps for strengthening system coherence.';
    var ctaLines = doc.splitTextToSize(ctaBodyText, CW - 28);
    var ctaBodyH = ctaLines.length * (9 * 1.6);

    // Layout inside box:
    //   padding top 14  +  name 14  +  credentials 16  +  gap 6  +  body  +  padding bottom 14
    var ctaH = 14 + 14 + 16 + 6 + ctaBodyH + 14;
    if (ctaH < 90) ctaH = 90; // enforce minimum visual weight

    // If box won't fit on this page, start a new one
    if (y + ctaH > SAFE_BOTTOM) {
      doc.addPage();
      pageHeader();
      pageFooter();
      y = TOP;
    }

    doc.setDrawColor.apply(doc, DIVIDER);
    doc.setLineWidth(0.5);
    doc.rect(ML, y, CW, ctaH);
    doc.setDrawColor.apply(doc, GOLD);
    doc.setLineWidth(2);
    doc.line(ML, y, ML + CW, y); // gold top border

    setFont(11, 'bold', NAVY);
    doc.text('Christine Kahane', ML + 14, y + 18);
    setFont(8, 'normal', SLATE_MID);
    // FIX 2: Replace Unicode middots with hyphens in credentials string
    doc.text('NBC-HWC  -  MCWC  -  TIPF  -  Founder, Coherence Company', ML + 14, y + 32);
    setFont(9, 'normal', SLATE);
    doc.text(ctaLines, ML + 14, y + 48);

    // Save
    var filename = 'Coherence-Diagnostic-' + name.replace(/\s+/g, '-') + '.pdf';
    doc.save(filename);
  }

  // ── Main generate function ────────────────────────────────────────────
  function generateReport(name, email) {
    btnGenerate.textContent = 'Generating...';
    btnGenerate.disabled = true;

    var answerLetters = answers.map(function(i) { return ['A','B','C','D'][i]; });

    try {
      var result = scoreAnswers(answerLetters, name, email);

      document.getElementById('confirm-report-id').textContent = result.report_id;
      document.getElementById('confirm-pattern').textContent   = result.patterns.primary;
      document.getElementById('confirm-pressure').textContent  = result.pressure.level;

      window._diagnosticResult = result;

      // Generate and download PDF
      generatePDF(result);

      // Fire emails
      var emailParams = {
        user_name:         name,
        user_email:        email,
        report_id:         result.report_id,
        primary_pattern:   result.patterns.primary,
        secondary_pattern: result.patterns.secondary,
        pressure_level:    result.pressure.level,
        d_count:           result.validity.d_count,
        likely_gamed:      result.validity.likely_gamed ? 'YES — review before debrief' : 'No',
        raw_answers:       result.raw_answers.join(', '),
        date:              result.date_display,
      };

      var SERVICE_ID  = 'service_9dfgwpk';
      var USER_TMPL   = 'template_fwseyak';
      var NOTIFY_TMPL = 'template_vib2asp';

      Promise.all([
        emailjs.send(SERVICE_ID, USER_TMPL,   emailParams),
        emailjs.send(SERVICE_ID, NOTIFY_TMPL, emailParams),
      ]).then(function() {
        console.log('Both emails sent successfully.');
      }).catch(function(err) {
        console.error('EmailJS error:', err);
      });

      showScreen(screenConf);

    } catch(err) {
      alert('Something went wrong generating your report. Please try again.');
      btnGenerate.textContent = 'Generate My Report';
      btnGenerate.disabled = false;
      console.error('Report error:', err);
    }
  }
</script>

</Layout>

