---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Coherence Chronicles — The Coherence Co.',
  description: 'Structural thinking for executive leaders on decision governance, signal clarity, and organizational coherence. Published by The Coherence Company when the thinking is ready.',
};

const posts = [
  {
    slug: 'when-urgency-becomes-the-strategy',
    date: 'February 12, 2026',
    category: 'Signal Clarity',
    title: 'When Urgency Becomes the Strategy',
    excerpt: 'Most organizations don\'t choose urgency. It accumulates. One compressed decision cycle leads to another, and eventually the pace becomes the plan. Here\'s what that costs — and how to recognize it before it compounds.',
    readTime: '4 min read',
  },
  {
    slug: 'the-cost-of-undocumented-decisions',
    date: 'January 28, 2026',
    category: 'Decision Governance',
    title: 'The Cost of Undocumented Decisions',
    excerpt: 'Verbal alignment is not governance. When major commitments live only in memory — and in three different versions of what was agreed — the organization pays a structural tax on every subsequent decision that depends on them.',
    readTime: '3 min read',
  },
];
---

<Layout metadata={metadata}>

  <section class="chronicles-hero">
    <div class="container">
      <span class="eyebrow">The Coherence Co.</span>
      <h1 class="hero-headline">Coherence Chronicles</h1>
      <p class="hero-sub">Structural thinking for executive teams navigating pressure, pace, and organizational coherence. Published when the thinking is ready — not on a schedule.</p>
      <div class="newsletter-strip">
        <span class="newsletter-label">Subscribe to the Chronicles</span>
        <form class="newsletter-form" onsubmit="return false;">
          <input type="email" placeholder="your@email.com" class="newsletter-input" />
          <button type="submit" class="newsletter-btn">Subscribe</button>
        </form>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="posts-grid">
        {posts.map((post) => (
          <a href={`/chronicles/${post.slug}`} class="post-card">
            <div class="post-meta">
              <span class="post-category">{post.category}</span>
              <span class="post-dot">·</span>
              <span class="post-date">{post.date}</span>
              <span class="post-dot">·</span>
              <span class="post-read">{post.readTime}</span>
            </div>
            <h2 class="post-title">{post.title}</h2>
            <p class="post-excerpt">{post.excerpt}</p>
            <span class="post-cta">Read →</span>
          </a>
        ))}
      </div>

      <div class="coming-soon">
        <div class="coming-rule"></div>
        <p class="coming-text">More dispatches forthcoming. <a href="#subscribe" class="coming-link">Subscribe to be notified.</a></p>
      </div>
    </div>
  </section>

</Layout>

<style>
  :root {
    --navy:        #13294B;
    --navy-deep:   #F0EDE8;
    --navy-mid:    #FAF8F5;
    --navy-light:  #F5F2EC;
    --gold:        #C4922A;
    --gold-light:  #D4A84B;
    --gold-dim:    rgba(196, 146, 42, 0.08);
    --gold-border: rgba(196, 146, 42, 0.3);
    --white:       #13294B;
    --slate:       #2C3A4A;
    --slate-dim:   rgba(44, 58, 74, 0.7);
    --border:      rgba(19, 41, 75, 0.12);
  }

  .container { max-width: 860px; margin: 0 auto; padding: 0 2rem; }
  .section { padding: 80px 0 120px; }

  .chronicles-hero {
    background: var(--navy-deep);
    padding: 160px 0 80px;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--slate-dim);
    line-height: 1.75;
    max-width: 560px;
    margin-bottom: 2.5rem;
  }

  .newsletter-strip {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .newsletter-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate-dim);
    white-space: nowrap;
  }

  .newsletter-form {
    display: flex;
    gap: 0;
    flex: 1;
    min-width: 260px;
    max-width: 420px;
  }

  .newsletter-input {
    flex: 1;
    background: #ffffff;
    border: 1px solid var(--border);
    border-right: none;
    color: #13294B;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    padding: 0.65rem 1rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .newsletter-input::placeholder { color: var(--slate-dim); }
  .newsletter-input:focus { border-color: var(--gold-border); }

  .newsletter-btn {
    background: var(--gold);
    color: #ffffff;
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.65rem 1.25rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .newsletter-btn:hover { background: var(--gold-light); }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .post-card {
    background: var(--navy-mid);
    padding: 2.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: background 0.25s ease;
  }

  .post-card:hover { background: var(--navy-light); }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .post-category {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .post-dot { color: var(--slate-dim); font-size: 0.7rem; }
  .post-date, .post-read { font-size: 0.7rem; color: var(--slate-dim); letter-spacing: 0.03em; }

  .post-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.25;
  }

  .post-excerpt {
    font-size: 0.92rem;
    color: var(--slate-dim);
    line-height: 1.75;
    max-width: 640px;
  }

  .post-cta {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    margin-top: 0.25rem;
  }

  .coming-soon { margin-top: 3rem; text-align: center; }

  .coming-rule {
    width: 40px;
    height: 1px;
    background: var(--gold-border);
    margin: 0 auto 1.5rem;
  }

  .coming-text { font-size: 0.85rem; color: var(--slate-dim); }
  .coming-link { color: var(--gold); text-decoration: none; }
  .coming-link:hover { color: var(--gold-light); }

  @media (max-width: 640px) {
    .chronicles-hero { padding: 140px 0 60px; }
    .post-card { padding: 1.75rem; }
    .newsletter-strip { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .newsletter-form { max-width: 100%; width: 100%; }
  }
</style>
