    border-left: 2px solid var(--gold);
    padding: 1.25rem 1.75rem;
    background: var(--gold-dim);
    margin: 2rem 0;
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    font-style: italic;
