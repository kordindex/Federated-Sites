---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact — The Coherence Co.',
  description: 'Start a conversation with The Coherence Co.',
};
---

<Layout metadata={metadata}>

  <!-- ─── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="contact-hero">
    <div class="container">
      <span class="eyebrow">The Coherence Co.</span>
      <h1 class="hero-headline">Start a Conversation</h1>
      <p class="hero-sub">Tell us what you're seeing. We'll tell you what it means.</p>
    </div>
  </section>

  <!-- ─── Form + Info ───────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="contact-grid">

        <!-- Left — Info -->
        <div class="contact-info">
          <div class="info-block">
            <span class="info-label">What happens next</span>
            <p class="info-body">Every inquiry is reviewed by Christine personally. You'll hear back within one business day. If your situation calls for a structured engagement, she'll say so clearly. If it doesn't, she'll say that too.</p>
          </div>

          <div class="info-divider"></div>

          <div class="info-block">
            <span class="info-label">Not ready to reach out?</span>
            <p class="info-body">Start with the Essential Coherence Diagnostic. $395. Fifteen minutes. A four-page report that names what you're already seeing.</p>
            <a href="/resources" class="info-link">View the Diagnostic →</a>
          </div>

          <div class="info-divider"></div>

          <div class="info-block">
            <span class="info-label">Confidentiality</span>
            <p class="info-body">Everything stays in the room. We never reference specific client situations, challenges, or data in any public context.</p>
          </div>
        </div>

        <!-- Right — Form -->
        <div class="contact-form-wrap">
          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="contact-form"
            id="contact-form"
          >
            <input type="hidden" name="access_key" value="11cb0668-4dcd-473a-9784-3c2290917a75">
            <input type="hidden" name="subject" value="New Contact Inquiry — The Coherence Co.">
            <input type="hidden" name="redirect" value="false">
            <input type="checkbox" name="botcheck" style="display:none">

            <div class="field-group">
              <label class="field-label" for="name">Your Name</label>
              <input
                class="field-input"
                type="text"
                id="name"
                name="name"
                placeholder="Full name"
                required
              >
            </div>

            <div class="field-group">
              <label class="field-label" for="email">Email Address</label>
              <input
                class="field-input"
                type="email"
                id="email"
                name="email"
                placeholder="you@organization.com"
                required
              >
            </div>

            <div class="field-group">
              <label class="field-label" for="interest">What are you interested in?</label>
              <div class="select-wrap">
                <select class="field-select" id="interest" name="interest" required>
                  <option value="" disabled selected>Select one</option>
                  <option value="Essential Coherence Diagnostic ($395)">Essential Coherence Diagnostic ($395)</option>
                  <option value="Executive Coherence Architecture ($2,500)">Executive Coherence Architecture ($2,500)</option>
                  <option value="Leadership Calibration Labs">Leadership Calibration Labs</option>
                  <option value="The Coherence Intensive">The Coherence Intensive</option>
                  <option value="General Inquiry">General Inquiry</option>
                </select>
                <span class="select-arrow">↓</span>
              </div>
            </div>

            <button type="submit" class="submit-btn" id="submit-btn">
              Send Your Inquiry
            </button>

            <!-- Success / Error states -->
            <div class="form-success" id="form-success">
              <span class="success-mark">—</span>
              <p class="success-title">Received.</p>
              <p class="success-body">Christine will be in touch within one business day.</p>
            </div>

            <div class="form-error" id="form-error">
              <p>Something went wrong. Please try again or email directly.</p>
            </div>

          </form>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const btn = document.getElementById('submit-btn');
  const success = document.getElementById('form-success');
  const error = document.getElementById('form-error');

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    btn.textContent = 'Sending...';
    btn.disabled = true;

    const data = new FormData(form);

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data
      });
      const json = await res.json();

      if (json.success) {
        form.style.display = 'none';
        success.style.display = 'block';
      } else {
        error.style.display = 'block';
        btn.textContent = 'Send Your Inquiry';
        btn.disabled = false;
      }
    } catch(err) {
      error.style.display = 'block';
      btn.textContent = 'Send Your Inquiry';
      btn.disabled = false;
    }
  });
</script>

<style>
  :global(body) { background-color: #0f1623; }

  :root {
    --navy:       #1b263b;
    --navy-deep:  #0f1623;
    --navy-mid:   #152033;
    --gold:       #b59353;
    --gold-light: #c9aa70;
    --gold-border:rgba(181,147,83,0.3);
    --white:      #ffffff;
    --slate:      #d0d4db;
    --slate-dim:  rgba(208,212,219,0.55);
    --border:     rgba(255,255,255,0.08);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section { padding: 80px 0 120px; }

  /* ─── Hero ──────────────────────────────────────────────────────────────── */
  .contact-hero {
    background: var(--navy-deep);
    padding: 160px 0 80px;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--slate-dim);
    line-height: 1.75;
  }

  /* ─── Grid ───────────────────────────────────────────────────────────────── */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 5rem;
    align-items: start;
  }

  /* ─── Info ───────────────────────────────────────────────────────────────── */
  .info-block { margin-bottom: 0; }

  .info-label {
    display: block;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }

  .info-body {
    font-size: 0.88rem;
    color: var(--slate-dim);
    line-height: 1.8;
  }

  .info-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--gold);
    text-decoration: none;
    transition: color 0.2s;
  }

  .info-link:hover { color: var(--gold-light); }

  .info-divider {
    height: 1px;
    background: var(--border);
    margin: 2rem 0;
  }

  /* ─── Form ───────────────────────────────────────────────────────────────── */
  .contact-form-wrap {
    background: var(--navy-mid);
    border: 1px solid var(--border);
    border-top: 2px solid var(--gold);
    padding: 2.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate-dim);
  }

  .field-input {
    background: var(--navy-deep);
    border: 1px solid var(--border);
    color: var(--white);
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    padding: 0.85rem 1rem;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }

  .field-input::placeholder { color: var(--slate-dim); }
  .field-input:focus { border-color: var(--gold-border); }

  .select-wrap {
    position: relative;
  }

  .field-select {
    appearance: none;
    background: var(--navy-deep);
    border: 1px solid var(--border);
    color: var(--white);
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    padding: 0.85rem 2.5rem 0.85rem 1rem;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
    cursor: pointer;
  }

  .field-select:focus { border-color: var(--gold-border); }

  .field-select option {
    background: var(--navy-mid);
    color: var(--white);
  }

  .select-arrow {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gold);
    font-size: 0.7rem;
    pointer-events: none;
  }

  .submit-btn {
    background: var(--gold);
    color: var(--navy-deep);
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 1rem;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 0.5rem;
  }

  .submit-btn:hover:not(:disabled) { background: var(--gold-light); }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  /* ─── Success / Error ────────────────────────────────────────────────────── */
  .form-success {
    display: none;
    text-align: center;
    padding: 2rem 0;
  }

  .success-mark {
    display: block;
    font-size: 1.5rem;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .success-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: var(--white);
    margin-bottom: 0.5rem;
  }

  .success-body {
    font-size: 0.85rem;
    color: var(--slate-dim);
  }

  .form-error {
    display: none;
    font-size: 0.8rem;
    color: #e07070;
    text-align: center;
    padding: 0.75rem;
    border: 1px solid rgba(224,112,112,0.3);
    background: rgba(224,112,112,0.06);
  }

  /* ─── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .contact-hero { padding: 140px 0 60px; }
    .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
    .contact-form-wrap { padding: 2rem; }
  }
</style>