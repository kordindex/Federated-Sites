import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact — The Coherence Co.',
  description: 'Start a conversation with The Coherence Co.',
};
---

<Layout metadata={metadata}>

  <section class="contact-hero">
    <div class="container">
      <span class="eyebrow">The Coherence Co.</span>
      <h1 class="hero-headline">Start a Conversation</h1>
      <p class="hero-sub">Tell us what you're seeing. We'll tell you what it means.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">

        <div class="contact-info">
          <div class="info-block">
            <span class="info-label">What happens next</span>
            <p class="info-body">Every inquiry is reviewed by Christine personally. You'll hear back within one business day. If your situation calls for a structured engagement, she'll say so clearly. If it doesn't, she'll say that too.</p>
          </div>
          <div class="info-divider"></div>
          <div class="info-block">
            <span class="info-label">Not ready to reach out?</span>
            <p class="info-body">Start with the Essential Coherence Diagnostic. $395. Fifteen minutes. A four-page report that names what you're already seeing.</p>
            <a href="/resources" class="info-link">View the Diagnostic →</a>
          </div>
          <div class="info-divider"></div>
          <div class="info-block">
            <span class="info-label">Confidentiality</span>
            <p class="info-body">Everything stays in the room. We never reference specific client situations, challenges, or data in any public context.</p>
          </div>
        </div>

        <div class="contact-form-wrap" id="contact-form-wrap">
          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="contact-form"
            id="contact-form"
          >
            <input type="hidden" name="access_key" value="11cb0668-4dcd-473a-9784-3c2290917a75">
            <input type="hidden" name="subject" value="New Contact Inquiry — The Coherence Co.">
            <input type="hidden" name="redirect" value="false">
            <input type="checkbox" name="botcheck" style="display:none">

            <div class="field-group">
              <label class="field-label" for="name">Your Name</label>
              <input class="field-input" type="text" id="name" name="name" placeholder="Full name" required>
            </div>

            <div class="field-group">
              <label class="field-label" for="email">Email Address</label>
              <input class="field-input" type="email" id="email" name="email" placeholder="you@organization.com" required>
            </div>

            <div class="field-group">
              <label class="field-label" for="interest">What are you interested in?</label>
              <div class="select-wrap">
                <select class="field-select" id="interest" name="interest" required>
                  <option value="" disabled selected>Select one</option>
                  <option value="Essential Coherence Diagnostic ($395)">Essential Coherence Diagnostic ($395)</option>
                  <option value="Executive Coherence Architecture ($2,500)">Executive Coherence Architecture ($2,500)</option>
                  <option value="Leadership Calibration Labs">Leadership Calibration Labs</option>
                  <option value="The Coherence Intensive">The Coherence Intensive</option>
                  <option value="General Inquiry">General Inquiry</option>
                </select>
                <span class="select-arrow">↓</span>
              </div>
            </div>

            <div class="field-group">
              <label class="field-label" for="message">Message</label>
              <textarea class="field-input" id="message" name="message" rows="4" placeholder="How can we help?" required></textarea>
            </div>

            <button type="submit" class="submit-btn" id="submit-btn">
              Send Your Inquiry
            </button>

          </form>

          <div class="form-success" id="form-success">
            <span class="success-mark">—</span>
            <p class="success-title">Received.</p>
            <p class="success-body">Christine will be in touch within one business day.</p>
          </div>

          <div class="form-error" id="form-error">
            <p>Something went wrong. Please try again or email directly.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <script is:inline>
  document.getElementById('contact-form').addEventListener('submit', function(e) {
    e.preventDefault();
    var form = document.getElementById('contact-form');
    var btn = document.getElementById('submit-btn');
    var success = document.getElementById('form-success');
    var error = document.getElementById('form-error');

    btn.textContent = 'Sending...';
    btn.disabled = true;

    fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      body: new FormData(form)
    })
    .then(function(res) { return res.json(); })
    .then(function(json) {
      if (json.success) {
        form.style.display = 'none';
        success.style.display = 'block';
      } else {
        error.style.display = 'block';
        btn.textContent = 'Send Your Inquiry';
        btn.disabled = false;
      }
    })
    .catch(function() {
      error.style.display = 'block';
      btn.textContent = 'Send Your Inquiry';
      btn.disabled = false;
    });
  });
  </script>

</Layout>

<style is:global>
  /* Override Tailwind preflight for form elements */
  .contact-form input,
  .contact-form select,
  .contact-form button,
  .contact-form textarea {
    font-family: 'Inter', sans-serif !important;
    font-size: 0.9rem !important;
    border-radius: 0 !important;
    -webkit-appearance: none !important;
    appearance: none !important;
    box-sizing: border-box !important;
    color: #13294B !important;
    background-color: #ffffff !important;
    border: 1px solid rgba(19, 41, 75, 0.15) !important;
    padding: 0.85rem 1rem !important;
    width: 100% !important;
  }

  .field-select option {
    background: #ffffff;
    color: #13294B;
  }

  :root {
    --navy:        #13294B;
    --navy-deep:   #F0EDE8;
    --navy-mid:    #FAF8F5;
    --gold:        #C4922A;
    --gold-light:  #D4A84B;
    --gold-border: rgba(196, 146, 42, 0.3);
    --white:       #13294B;
    --slate:       #2C3A4A;
    --slate-dim:   rgba(44, 58, 74, 0.7);
    --border:      rgba(19, 41, 75, 0.12);
  }

  .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
  .section { padding: 80px 0 120px; }

  .contact-hero {
    background: var(--navy-deep);
    padding: 160px 0 80px;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    display: block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--slate-dim);
    line-height: 1.75;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 5rem;
    align-items: start;
  }

  .info-block { margin-bottom: 0; }

  .info-label {
    display: block;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.75rem;
  }

  .info-body {
    font-size: 0.88rem;
    color: var(--slate-dim);
    line-height: 1.8;
  }

  .info-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--gold);
    text-decoration: none;
    transition: color 0.2s;
  }

  .info-link:hover { color: var(--gold-light); }

  .info-divider {
    height: 1px;
    background: var(--border);
    margin: 2rem 0;
  }

  .contact-form-wrap {
    background: #ffffff;
    border: 1px solid var(--border);
    border-top: 2px solid var(--gold);
    padding: 2.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate-dim);
  }

  .field-input {
    background: #ffffff;
    border: 1px solid var(--border);
    color: #13294B;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    padding: 0.85rem 1rem;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }

  .field-input::placeholder { color: rgba(44, 58, 74, 0.4); }
  .field-input:focus { border-color: var(--gold-border); }

  .select-wrap { position: relative; }

  .field-select {
    appearance: none;
    background: #ffffff;
    border: 1px solid var(--border);
    color: #13294B;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    padding: 0.85rem 2.5rem 0.85rem 1rem;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
    cursor: pointer;
  }

  .field-select:focus { border-color: var(--gold-border); }

  .field-select option {
    background: #ffffff;
    color: #13294B;
  }

  .select-arrow {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gold);
    font-size: 0.7rem;
    pointer-events: none;
  }

  .submit-btn {
    background: var(--navy);
    color: #ffffff;
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 1rem;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 0.5rem;
  }

  .submit-btn:hover:not(:disabled) { background: var(--navy-mid); }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .form-success {
    display: none;
    text-align: center;
    padding: 2rem 0;
  }

  .success-mark {
    display: block;
    font-size: 1.5rem;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .success-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: var(--white);
    margin-bottom: 0.5rem;
  }

  .success-body {
    font-size: 0.85rem;
    color: var(--slate-dim);
  }

  .form-error {
    display: none;
    font-size: 0.8rem;
    color: #c0392b;
    text-align: center;
    padding: 0.75rem;
    border: 1px solid rgba(192, 57, 43, 0.3);
    background: rgba(192, 57, 43, 0.06);
  }

  @media (max-width: 768px) {
    .contact-hero { padding: 140px 0 60px; }
    .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
    .contact-form-wrap { padding: 2rem; }
  }
</style>