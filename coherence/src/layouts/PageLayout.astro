---
import Layout from '~/layouts/Layout.astro';
import GlobalFooter from '@shared/GlobalFooter.astro';
import FederatedNav from '@shared/FederatedNav.astro';
import type { MetaData } from '~/types';
import CoherenceNav from '@shared/CoherenceNav.astro';

export interface Props {
  metadata?: MetaData;
}
const { metadata } = Astro.props;
---
<Layout metadata={metadata}>
  <FederatedNav activePillar="coherence" />
  <CoherenceNav />
  <main>
    <slot />
  </main>
  <slot name="footer">
    <GlobalFooter />
  </slot>
</Layout>