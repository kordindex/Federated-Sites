---
// shared/components/FederatedNav.astro
// Federated ecosystem switcher — consistent across all three sites
// Style: white background, dividers, active = limestone tint, full width

const { activePillar } = Astro.props;
---

<nav class="fed-nav" aria-label="Ecosystem navigation">
  <a
    href="https://institute-unlearning.vercel.app/"
    class={`pillar pillar-inst ${activePillar === 'institute' ? 'active' : ''}`}
  >
    <span>The Master Brand</span>
    <h4>The Institute</h4>
  </a>
  <a
    href="https://coherence-company.vercel.app/"
    class={`pillar pillar-cohe ${activePillar === 'coherence' ? 'active' : ''}`}
  >
    <span>B2B / Organizations</span>
    <h4>The Coherence Co.</h4>
  </a>
  <a
    href="https://kahane-coaching.vercel.app/"
    class={`pillar pillar-coac ${activePillar === 'kahane' ? 'active' : ''}`}
  >
    <span>B2C / Individuals</span>
    <h4>Kahane Coaching</h4>
  </a>
</nav>

<style>
  .fed-nav {
    display: flex;
    width: 100%;
    background: #fff;
    border-bottom: 1px solid rgba(24, 51, 47, 0.1);
    overflow-x: auto;
  }

  .pillar {
    flex: 1;
    min-width: 160px;
    padding: 0.5rem 1.5rem;
    text-decoration: none;
    border-right: 1px solid rgba(24, 51, 47, 0.1);
    transition: background 0.2s;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .pillar:last-child {
    border-right: none;
  }

  .pillar:hover {
    background: #EEF2F1;
  }

  .pillar.active {
    background: #EEF2F1;
  }

  .pillar span {
    display: block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #8C9490;
    margin-bottom: 0.15rem;
    line-height: 1.2;
  }

  .pillar h4 {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: #2C3A4A;
    line-height: 1.3;
    margin: 0;
    text-transform: none;
    letter-spacing: normal;
  }

  .pillar.active h4 {
    color: #18332F;
  }

  @media (max-width: 900px) {
    .pillar span {
      display: none;
    }
  }
</style>