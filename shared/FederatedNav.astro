---
const { activePillar } = Astro.props;
---

<div class="fed-nav-wrap">
  <nav class="fed-nav" aria-label="Ecosystem navigation">
    <a
      href="https://institute-unlearning.vercel.app/"
      class={`pillar pillar-inst ${activePillar === 'institute' ? 'active' : ''}`}
    >
      <span class="pillar-label">The Master Brand</span>
      <h4 class="pillar-name">The Institute</h4>
    </a>
    <a
      href="https://coherence-company.vercel.app/"
      class={`pillar pillar-cohe ${activePillar === 'coherence' ? 'active' : ''}`}
    >
      <span class="pillar-label">B2B / Organizations</span>
      <h4 class="pillar-name">The Coherence Co.</h4>
    </a>
    <a
      href="https://kahane-coaching.vercel.app/"
      class={`pillar pillar-coac ${activePillar === 'kahane' ? 'active' : ''}`}
    >
      <span class="pillar-label">B2C / Individuals</span>
      <h4 class="pillar-name">Kahane Coaching</h4>
    </a>
  </nav>
</div>

<style>
  .fed-nav-wrap {
    background: #fff;
    border-bottom: 1px solid rgba(24, 51, 47, 0.1);
    overflow-x: auto;
  }
  .fed-nav {
    display: flex;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }
  .pillar {
    flex: 1;
    min-width: 140px;
    padding: 0.5rem 1rem 0.5rem 0;
    text-decoration: none;
    border-right: 1px solid rgba(24, 51, 47, 0.1);
    border-bottom: 2px solid transparent;
    transition: background 0.2s, border-bottom-color 0.2s;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .pillar:first-child { padding-left: 0; }
  .pillar:last-child { border-right: none; padding-right: 0; }
  .pillar-label {
    display: block;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #8C9490;
    margin-bottom: 0.15rem;
    line-height: 1.2;
  }
  .pillar-name {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: #2C3A4A;
    line-height: 1.3;
    margin: 0;
    text-transform: none;
    letter-spacing: normal;
  }
  .pillar-inst:hover { background: #eaeaea; }
  .pillar-inst.active { border-bottom-color: #aaaaaa; }
  .pillar-inst.active .pillar-name { color: #333333; }
  .pillar-cohe:hover { background: rgba(19, 41, 75, 0.05); }
  .pillar-cohe.active { border-bottom-color: #13294B; }
  .pillar-cohe.active .pillar-name { color: #13294B; }
  .pillar-coac:hover { background: rgba(24, 51, 47, 0.05); }
  .pillar-coac.active { border-bottom-color: #18332F; }
  .pillar-coac.active .pillar-name { color: #18332F; }
  @media (max-width: 900px) {
    .fed-nav { padding: 0 1.5rem; }
    .pillar-label { display: none; }
    .pillar {
      padding: 0.6rem 0.75rem;
      min-width: 100px;
      align-items: center;
      text-align: center;
    }
    .pillar:first-child { padding-left: 0.75rem; }
  }
  @media (max-width: 480px) {
    .pillar-name { font-size: 0.65rem; }
    .pillar { min-width: 80px; padding: 0.5rem; }
  }
</style>
